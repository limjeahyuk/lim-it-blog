---
/**
 * 맨 아래 띠 — 저작권 한 줄 + 연락처 두 개.
 *
 * ⚠ 2026-09-08 시안에서 **Editors · Service · Contact 세 칸을 걷어냈습니다.**
 *   그 셋은 이미 메뉴 판(햄버거) 안에 다 있습니다. 아래 띠에 또 늘어놓으면
 *   같은 목록이 사이트에 두 벌이 되고, 지면마다 스크롤 끝에 화면 하나만큼의
 *   링크 더미가 붙습니다. **다시 넣지 마세요.**
 *
 * ⚠ 이제 **모든 지면**에 붙습니다 (BaseLayout 이 답니다). 예전에는 오른쪽
 *   열이 없는 지면에서만 썼는데, 줄 하나라 오른쪽 열과 겹칠 것이 없습니다.
 *   페이지에서 따로 <SiteFooter /> 를 부르지 마세요 — 두 번 나옵니다.
 *
 * 배경은 --card 입니다. 지면(--bg)보다 밝아서 글이 여기서 끝난다는 것이
 * 선 하나보다 잘 읽힙니다 — 머리띠와 같은 처리입니다.
 */
import { OWNER } from '../consts'
---

<footer class="foot">
  <div class="inner">
    <p class="copy">© {OWNER.name}</p>

    <nav class="links">
      <a href={`https://github.com/${OWNER.github}`}>github.com/{OWNER.github}</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href={`mailto:${OWNER.email}`}>{OWNER.email}</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background-color: var(--card);
  }

  /*
    가로 여백은 .foot 이 아니라 안쪽이 씁니다 — 지면(.wrap)이 max-width
    1280px **안에** 여백을 두기 때문에, 바깥에 두면 글 목록보다 띠가 그만큼
    넓게 퍼져서 양끝이 안 맞습니다. 선은 화면 끝까지 그대로 갑니다.
  */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem;
  }

  .copy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .links {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .links a {
    color: var(--text-faint);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text);
  }

  .dot {
    color: var(--text-faint);
    opacity: 0.6;
  }

  /* 지면이 여백을 2rem 으로 넓히는 지점과 같습니다 */
  @media (min-width: 900px) {
    .inner {
      padding-inline: 2rem;
    }
  }
</style>
