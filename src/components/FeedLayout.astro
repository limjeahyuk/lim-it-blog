---
import SideAuthors from './SideAuthors.astro'
import SideProjects from './SideProjects.astro'
import SideContact from './SideContact.astro'

interface Props {
  /** 지금 보고 있는 저자 (사이드바 강조용) */
  currentAuthor?: string
}

const { currentAuthor } = Astro.props as Props
---

<div class="container feed">
  {/*
    왼쪽 열은 **일부러 비워 둔 것**입니다. Editors 를 오른쪽으로 옮기면서
    비었는데, 지우면 지면이 화면 왼쪽으로 붙습니다. 자리만 잡아 둡니다.
  */}
  <aside class="lt" aria-hidden="true"></aside>

  <div class="mid">
    <div class="tags-mobile">
      <SideAuthors current={currentAuthor} />
    </div>
    <slot />
  </div>

  <aside class="rt">
    {/*
      폰에서는 이 자리가 글 목록 **아래**라 저자 목록이 있어봐야 안 눌립니다.
      위쪽 `.tags-mobile` 이 그 역할을 하므로 여기서는 넓은 화면에서만 켭니다.
    */}
    <div class="rt-authors">
      <SideAuthors current={currentAuthor} />
    </div>
    <SideProjects />
    <SideContact />
  </aside>
</div>

<style>
  .feed {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .feed {
      display: block;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  }

  /* 비어 있는 왼쪽 여백 열. 지면을 가운데로 밀어두는 역할만 합니다. */
  .lt {
    display: none;
    grid-column: span 2 / span 2;
  }

  .mid {
    grid-column: span 12 / span 12;
    min-width: 0;
  }

  /*
    오른쪽 열(Editors·Live Service·Contact)은 폰에서 글 목록 **아래**로 갑니다.
    예전에는 1024px 미만에서 통째로 숨겼는데, 그러면 폰으로 들어온 사람은
    만든 것과 연락처를 볼 방법이 아예 없었습니다.
    글이 끝나고 나서 나오면 되는 내용이라 자리를 옮기는 걸로 충분합니다.
  */
  .rt {
    display: block;
    margin-top: 2.5rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rt::-webkit-scrollbar {
    display: none;
  }

  .rt-authors {
    display: none;
  }

  .tags-mobile {
    display: block;
  }

  @media (min-width: 1024px) {
    .lt,
    .rt,
    .rt-authors {
      display: block;
    }

    .mid {
      grid-column: span 7 / span 7;
    }

    .rt {
      grid-column: span 3 / span 3;
      margin-top: 0;
      position: sticky;
      top: 63px;
      max-height: calc(100vh - 73px);
      overflow-y: auto;
    }

    .tags-mobile {
      display: none;
    }
  }
</style>
