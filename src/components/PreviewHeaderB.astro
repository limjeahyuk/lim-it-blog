---
/**
 * 헤더 시안 2 — 제호형.
 *
 * 이름을 가운데 크게 놓고, 메뉴는 그 아래 한 줄로 내립니다. 잡지 표지의
 * 제호처럼 쓰는 방식이라 홈이 "여기가 어디인가"부터 보여줍니다.
 *
 * ⚠ 두 줄이라 지금(3rem)보다 높습니다 — 폰에서 5.5rem, 큰 화면 6.5rem.
 *   글 목록이 그만큼 아래에서 시작합니다.
 * ⚠ 임시입니다. 고르고 나면 Header.astro 로 옮기고 지웁니다.
 */
import Icon from './Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import { SITE_TITLE } from '../consts'
---

<header>
  <div class="top">
    <a class="logo" href="/">{SITE_TITLE}</a>
    <div class="tools">
      <a class="icon" href="/search" aria-label="검색"><Icon name="search" size={18} /></a>
      <ThemeToggle />
    </div>
  </div>

  <nav>
    <a href="/authors">Editors</a>
    <a href="/posts">Posts</a>
    <a href="/projects">Live Service</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-decoration: none;
    color: var(--text);
  }

  .tools {
    position: absolute;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon {
    display: flex;
    color: var(--text-dim);
  }

  .icon:hover {
    color: var(--text);
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    padding-bottom: 0.75rem;
  }

  nav a {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  @media (min-width: 900px) {
    .top {
      height: 4rem;
    }
    .logo {
      font-size: 1.875rem;
    }
    nav {
      gap: 2rem;
      padding-bottom: 0.875rem;
    }
  }
</style>
