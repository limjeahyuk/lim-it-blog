---
import '../styles/global.css'
import { Font } from 'astro:assets'
import {
  OWNER,
  SITE_DESCRIPTION,
  SITE_TAGLINE,
  SITE_TITLE,
  SITE_VERIFICATION,
} from '../consts'

interface Props {
  title: string
  description: string
  /** 공유 카드 사진. `/images/…` 공개 경로입니다 (content.config.ts 의 heroImage). */
  image?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  /** 글을 쓴 저자 이름 (화면 byline 과 같은 값). 없으면 사이트 주인으로 떨어집니다. */
  authorName?: string
  /** 검색엔진에 이 페이지를 넣지 않습니다. 내용이 브라우저에서 채워지는 지면용. */
  noindex?: boolean
}

const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  authorName,
  noindex = false,
} = Astro.props as Props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
// 홈은 `lim-it — 개발 매거진`, 나머지는 `<제목> — lim-it`.
const fullTitle =
  title === SITE_TITLE
    ? `${SITE_TITLE} — ${SITE_TAGLINE}`
    : `${title} — ${SITE_TITLE}`

// 글에 heroImage 가 없을 때 공유 카드가 텅 비지 않게 프로필 이미지를 씁니다.
const ogImage = new URL(image ?? '/avatar-512.png', Astro.site)

/**
 * 구조화 데이터. 구글이 이 페이지가 "글"인지 "사이트"인지 알아보게 합니다.
 * 여기 적는 값은 전부 화면에도 있는 것이어야 합니다 — 안 보이는 정보를
 * 구조화 데이터에만 넣으면 스팸으로 봅니다.
 */
const person = {
  '@type': 'Person',
  name: OWNER.name,
  url: `https://github.com/${OWNER.github}`,
}

/**
 * 글의 저자는 화면 byline 에 나오는 이름(임 Student 등)을 씁니다.
 * 발행자만 사이트 주인입니다 — 오른쪽 Profile 카드와 저작권 줄에 있습니다.
 */
const byline = authorName ? { '@type': 'Person', name: authorName } : person

const schema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonicalURL.href,
        mainEntityOfPage: canonicalURL.href,
        image: ogImage.href,
        inLanguage: 'ko-KR',
        author: byline,
        publisher: person,
        ...(pubDate && { datePublished: pubDate.toISOString() }),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: Astro.site?.href,
        inLanguage: 'ko-KR',
        author: person,
      }
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{/*
  파비콘. SVG 판이 없어서 .ico 하나로 갑니다 — 브라우저는 SVG 아이콘이
  걸려 있으면 그쪽을 먼저 쓰기 때문에, 예전 Astro 기본 favicon.svg 를
  지우지 않으면 .ico 를 바꿔도 탭에는 계속 옛 아이콘이 뜹니다.
*/}
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
{/* 홈 화면에 추가할 때 쓰이는 아이콘 (iOS 는 manifest 를 안 보고 이것만 봅니다) */}
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{/*
  검색엔진 소유권 확인. 값은 `consts.ts` 의 SITE_VERIFICATION 에 있습니다 —
  ⚠ 확인이 끝난 뒤에도 지우면 안 됩니다 (거기 이유를 적어 뒀습니다).
  빈 값은 태그를 아예 안 답니다. 빈 태그는 확인 실패로 잡힙니다.
*/}
{SITE_VERIFICATION.google && (
  <meta name="google-site-verification" content={SITE_VERIFICATION.google} />
)}
{SITE_VERIFICATION.naver && (
  <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />
)}
{SITE_VERIFICATION.bing && (
  <meta name="msvalidate.01" content={SITE_VERIFICATION.bing} />
)}

<Font cssVariable="--font-pretendard" preload />

{/*
  ⚠ `follow` 는 남겨 둡니다 — 이 지면을 색인하지 말라는 것이지
  여기서 나가는 링크를 따라가지 말라는 것이 아닙니다.
*/}
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage} />
{
  type === 'article' && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  type === 'article' && updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )
}

<meta
  name="twitter:card"
  content={image ? 'summary_large_image' : 'summary'}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>

{/* 테마를 페인트 전에 정해서 깜빡임을 막습니다. */}
<script is:inline>
  ;(() => {
    const saved = localStorage.getItem('theme')
    const theme =
      saved ??
      (window.matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark')
    document.documentElement.dataset.theme = theme
  })()
</script>
