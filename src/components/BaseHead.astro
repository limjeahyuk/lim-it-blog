---
import '../styles/global.css'
import type { ImageMetadata } from 'astro'
import { Font } from 'astro:assets'
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
}

const {
  title,
  description,
  image,
  type = 'website',
  pubDate,
  updatedDate,
} = Astro.props as Props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`

// 글에 heroImage 가 없을 때 공유 카드가 텅 비지 않게 프로필 이미지를 씁니다.
const ogImage = new URL(image?.src ?? '/avatar-512.png', Astro.site)

/**
 * 구조화 데이터. 구글이 이 페이지가 "글"인지 "사이트"인지 알아보게 합니다.
 * 여기 적는 값은 전부 화면에도 있는 것이어야 합니다 — 안 보이는 정보를
 * 구조화 데이터에만 넣으면 스팸으로 봅니다.
 */
const person = {
  '@type': 'Person',
  name: AUTHOR.name,
  url: `https://github.com/${AUTHOR.github}`,
}

const schema =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonicalURL.href,
        mainEntityOfPage: canonicalURL.href,
        image: ogImage.href,
        inLanguage: 'ko-KR',
        author: person,
        publisher: person,
        ...(pubDate && { datePublished: pubDate.toISOString() }),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE_TITLE,
        description: SITE_DESCRIPTION,
        url: Astro.site?.href,
        inLanguage: 'ko-KR',
        author: person,
      }
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-pretendard" preload />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage} />
{
  type === 'article' && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  type === 'article' && updatedDate && (
    <meta property="article:modified_time" content={updatedDate.toISOString()} />
  )
}

<meta
  name="twitter:card"
  content={image ? 'summary_large_image' : 'summary'}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>

{/* 테마를 페인트 전에 정해서 깜빡임을 막습니다. */}
<script is:inline>
  ;(() => {
    const saved = localStorage.getItem('theme')
    const theme =
      saved ??
      (window.matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark')
    document.documentElement.dataset.theme = theme
  })()
</script>
