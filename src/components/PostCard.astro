---
/**
 * 지면의 글 한 꼭지.
 *
 * 카드(상자)가 아니라 **줄**입니다. 벤치마킹한 매거진들이 공통으로 그랬고,
 * 상자를 겹겹이 쌓는 것보다 큰 제목 + 여백 쪽이 글 수가 많을 때 덜 지칩니다.
 *
 * 색은 저자 색 하나만 씁니다. 프로젝트 색까지 같이 띄우면 한 줄에 색이
 * 둘이라 어느 쪽이 분류인지 안 읽힙니다 — 프로젝트는 글자로만 둡니다.
 */
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import Icon from './Icon.astro'
import { getAuthor, getProject } from '../consts'

interface Props {
  post: CollectionEntry<'posts'>
  /** 저자 지면처럼 이미 저자가 정해진 자리에서는 이름을 빼도 됩니다. */
  hideAuthor?: boolean
}

const { post, hideAuthor = false } = Astro.props as Props
const { title, description, pubDate, author, project, secret } = post.data

const who = author ? getAuthor(author) : undefined
const proj = project ? getProject(project) : undefined
---

<article class="item">
  <div class="byline">
    {
      who && !hideAuthor && (
        <a class="who" href={`/authors/${who.id}`} style={`color:${who.color}`}>
          {who.name}
        </a>
      )
    }
    {proj && <a class="proj" href={`/projects/${proj.id}`}>{proj.name}</a>}
    <span class="date"><FormattedDate date={pubDate} /></span>
  </div>

  <a class="hit" href={`/posts/${post.id}/`}>
    <h2>
      {secret && <span class="lock" title="비밀글"><Icon name="lock" size={15} /></span>}
      {title}
    </h2>
    {description && <p class="summary">{description}</p>}
  </a>
</article>

<style>
  /* ⚠ 첫 꼭지만 크게 하던 것(lead)을 걷어냈습니다. 매거진 첫 화면 관례라
     따라했는데, 목록에서 그 한 줄만 튀어 보였습니다. 전부 같은 크기입니다. */
  .item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    line-height: 1.2;
  }

  /* 저자 이름은 색으로 구분합니다. 매거진에서 이름이 곧 분류라서
     여기가 이 줄에서 유일하게 색이 들어가는 자리입니다. */
  .who {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .who:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proj {
    color: var(--text-faint);
  }

  /* 가운뎃점은 저자 이름 뒤에 올 때만. 저자 지면에서는 이름을 빼기 때문에
     그냥 ::before 로 두면 점 하나가 앞에 덩그러니 남습니다. */
  .who + .proj::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .proj:hover {
    color: var(--text-dim);
  }

  .date {
    margin-left: auto;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .hit {
    display: block;
  }

  h2 {
    font-size: 1.25rem;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 1.4375rem;
    }
  }

  .hit:hover h2 {
    color: var(--accent-text);
  }

  /* 비밀글 자물쇠. 제목과 같은 줄에 붙되 크기는 글자를 따라갑니다. */
  .lock {
    display: inline-flex;
    vertical-align: -0.12em;
    margin-right: 0.15em;
    color: var(--text-faint);
  }

  .summary {
    display: none;
    margin: 0.5rem 0 0;
    line-height: 1.8;
    color: var(--text-dim);
  }

  @media (min-width: 768px) {
    .summary {
      display: block;
    }
  }
</style>
