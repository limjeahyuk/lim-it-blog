---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import { AUTHOR_LABEL, getProject } from '../consts'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props as Props
const { title, description, pubDate, project, author, tags } = post.data
const proj = project ? getProject(project) : undefined
---

<a class="wrap" href={`/posts/${post.id}/`}>
  <article class="card">
    {
      proj && (
        <div class="category">
          <span class="pill-category" style={`background-color:${proj.color}`}>
            {proj.name}
          </span>
        </div>
      )
    }
    <div class="content" data-category={!!proj}>
      <h2>{title}</h2>
      <div class="date">
        <FormattedDate date={pubDate} />
        <span class="sep">·</span>
        <span>{AUTHOR_LABEL[author]}</span>
      </div>
      <p class="summary">{description}</p>
      <div class="tags">
        {tags.map((tag) => <span class="pill">{tag}</span>)}
      </div>
    </div>
  </article>
</a>

<style>
  .card {
    overflow: hidden;
    position: relative;
    margin-bottom: 1.5rem;
    transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 768px) {
    .card {
      margin-bottom: 2rem;
    }
  }

  .wrap:hover .card {
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .category {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
  }

  .content {
    padding: 1.5rem 1rem 1rem;
  }

  .content[data-category='true'] {
    padding-top: 3.5rem;
  }

  h2 {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 1.25rem;
    }
  }

  .date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-faint);
  }

  .sep {
    opacity: 0.6;
  }

  .summary {
    display: none;
    margin: 0 0 1rem;
    line-height: 1.9;
    color: var(--text-dim);
  }

  @media (min-width: 768px) {
    .summary {
      display: block;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
