---
import Icon from './Icon.astro'
import type { SealedContent } from '../lib/secret'

interface Props {
  sealed: SealedContent
}

const { sealed } = Astro.props as Props
---

{/*
  본문 자리에 들어가는 자물쇠. 여기 있는 건 암호문뿐입니다 —
  비밀번호는 빌드하는 컴퓨터에만 있고 이 HTML에는 없습니다.
*/}
<div
  class="gate"
  data-secret-gate
  data-salt={sealed.salt}
  data-iv={sealed.iv}
  data-payload={sealed.data}
  data-iterations={String(sealed.iterations)}
>
  <div class="lock">
    <Icon name="lock" size={20} />
  </div>

  <p class="lead">비밀글입니다. 비밀번호를 넣으면 본문이 열립니다.</p>

  <form class="form" data-secret-form>
    <label class="sr-only" for="secret-password">비밀번호</label>
    <input
      id="secret-password"
      type="password"
      name="password"
      autocomplete="current-password"
      placeholder="비밀번호"
      required
    />
    <button type="submit">열기</button>
  </form>

  <p class="error" data-secret-error hidden>비밀번호가 맞지 않습니다.</p>
  <p class="note">한 번 열면 이 기기에서는 다음부터 바로 열립니다.</p>
</div>

<div class="prose" data-secret-content hidden></div>

<p class="relock" data-secret-relock hidden>
  <button type="button" data-secret-relock-button>
    <Icon name="lock" size={14} /> 이 기기에서 비밀번호 지우기
  </button>
</p>

<style>
  /* .gate 가 display:flex 라 UA 의 [hidden]{display:none} 을 이깁니다.
     이게 없으면 열고 나서도 자물쇠가 그대로 남습니다. */
  [hidden] {
    display: none !important;
  }

  .gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2.5rem 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-card);
    background-color: var(--surface-2);
  }

  .lock {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background-color: var(--card);
    color: var(--text-dim);
  }

  .lead {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 22rem;
    margin-top: 0.25rem;
  }

  input {
    flex: 1 1 10rem;
    min-width: 0;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--card);
    color: var(--text);
    /* 16px 미만이면 iOS 사파리가 포커스할 때 화면을 확대합니다. */
    font-size: 16px;
    font-family: inherit;
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  button[type='submit'] {
    flex: 0 0 auto;
    padding: 0.6rem 1.1rem;
    border: none;
    border-radius: var(--radius-lg);
    background-color: var(--accent);
    color: var(--pill-fg);
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
  }

  button[type='submit']:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .error {
    margin: 0;
    font-size: 0.875rem;
    color: var(--nj-red);
  }

  .note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .relock {
    margin: 1.5rem 0 0;
    text-align: right;
  }

  .relock button {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--text-faint);
    font-size: 0.8125rem;
    font-family: inherit;
    cursor: pointer;
  }

  .relock button:hover {
    color: var(--text);
  }
</style>

<script>
  /*
    비밀글 여는 쪽.

    빌드할 때 src/lib/secret.ts 가 잠근 것을 그대로 되돌립니다 —
    PBKDF2(SHA-256)로 키를 만들고 AES-GCM 으로 풉니다. 비밀번호가 틀리면
    AES-GCM 이 인증 태그에서 걸려 예외를 던집니다. 그래서 「맞는지 확인하는
    코드」가 따로 없습니다. 못 풀면 틀린 겁니다.

    ⚠ crypto.subtle 은 보안 컨텍스트(https 또는 localhost)에서만 있습니다.
  */
  const REMEMBER_KEY = 'lim-it:secret-password'

  const gate = document.querySelector<HTMLElement>('[data-secret-gate]')
  const form = document.querySelector<HTMLFormElement>('[data-secret-form]')
  const target = document.querySelector<HTMLElement>('[data-secret-content]')
  const error = document.querySelector<HTMLElement>('[data-secret-error]')
  const relock = document.querySelector<HTMLElement>('[data-secret-relock]')
  const relockButton = document.querySelector<HTMLButtonElement>(
    '[data-secret-relock-button]',
  )

  if (gate && form && target && error && relock && relockButton) {
    const fromBase64 = (value: string) =>
      Uint8Array.from(atob(value), (c) => c.charCodeAt(0))

    const salt = fromBase64(gate.dataset.salt ?? '')
    const iv = fromBase64(gate.dataset.iv ?? '')
    const payload = fromBase64(gate.dataset.payload ?? '')
    const iterations = Number(gate.dataset.iterations ?? '200000')

    const input = form.querySelector<HTMLInputElement>('input')!
    const submit = form.querySelector<HTMLButtonElement>('button')!

    async function decrypt(password: string): Promise<string> {
      const base = await crypto.subtle.importKey(
        'raw',
        new TextEncoder().encode(password),
        'PBKDF2',
        false,
        ['deriveKey'],
      )
      const key = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt, iterations, hash: 'SHA-256' },
        base,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt'],
      )
      const plain = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv },
        key,
        payload,
      )
      return new TextDecoder().decode(plain)
    }

    function reveal(html: string) {
      target.innerHTML = html
      target.hidden = false
      gate.hidden = true
      relock.hidden = false
    }

    async function tryUnlock(password: string, remember: boolean) {
      submit.disabled = true
      submit.textContent = '여는 중'
      try {
        const html = await decrypt(password)
        if (remember) localStorage.setItem(REMEMBER_KEY, password)
        reveal(html)
      } catch {
        // 기억해 둔 비밀번호가 틀렸다면(비밀번호를 바꿨다든지) 지웁니다.
        localStorage.removeItem(REMEMBER_KEY)
        error.hidden = false
        input.value = ''
        input.focus()
      } finally {
        submit.disabled = false
        submit.textContent = '열기'
      }
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault()
      error.hidden = true
      void tryUnlock(input.value, true)
    })

    relockButton.addEventListener('click', () => {
      localStorage.removeItem(REMEMBER_KEY)
      location.reload()
    })

    // 전에 열어봤으면 묻지 않고 바로 엽니다.
    const remembered = localStorage.getItem(REMEMBER_KEY)
    if (remembered) {
      decrypt(remembered)
        .then(reveal)
        .catch(() => localStorage.removeItem(REMEMBER_KEY))
    }
  }
</script>
