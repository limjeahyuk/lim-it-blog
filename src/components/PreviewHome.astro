---
/**
 * 시안 D 의 지면.
 *
 * 헤더 시안을 견주려고 페이지에서 떼어냈습니다 — /preview/d 와
 * /preview/header-* 가 같은 지면을 쓰고 헤더만 갈아 끼웁니다.
 *
 * ⚠ 임시입니다. 홈에 적용하고 나면 이 파일과 preview 페이지들을 지웁니다.
 */
import FormattedDate from './FormattedDate.astro'
import PreviewCover from './PreviewCover.astro'
import PreviewFooter from './PreviewFooter.astro'
import { AUTHORS, getAuthor, getProject } from '../consts'
import { coverOf } from '../lib/cover'
import { getPublishedPosts, postsByAuthor } from '../lib/posts'

const posts = await getPublishedPosts()
const lead = posts[0]

/** 저자별 묶음. 폰에서 2열이라 짝수로 끊습니다. */
const sections = AUTHORS.map((a) => ({
  author: a,
  items: postsByAuthor(posts, a.id)
    .filter((p) => p.id !== lead.id)
    .slice(0, 6),
})).filter((s) => s.items.length > 0)

/** 맨 아래 목록에는 위에서 이미 보여준 글을 빼고 최신순으로 채웁니다. */
const shown = new Set([lead.id, ...sections.flatMap((s) => s.items.map((p) => p.id))])
const recent = posts.filter((p) => !shown.has(p.id)).slice(0, 10)

const who = (id?: string) => (id ? getAuthor(id) : undefined)
const proj = (id?: string) => (id ? getProject(id) : undefined)
---


  {/* 읽기 진행 막대 — 헤더 바로 아래에 붙습니다 */}
  <div class="progress" aria-hidden="true"><span></span></div>

  {/* 첫 꼭지 — A 와 같습니다. 폰에서는 사진 위에, 큰 화면에서는 사진 옆에. */}
  <a class="lead" href={`/posts/${lead.id}/`} data-parallax>
    <PreviewCover
      cover={coverOf(lead)}
      alt=""
      ratio="3 / 4"
      tint={who(lead.data.author)?.color}
    />
    <div class="lead-text">
      <div class="lead-body">
        {
          who(lead.data.author) && (
            <span class="who" style={`color:${who(lead.data.author)!.color}`}>
              {who(lead.data.author)!.name}
            </span>
          )
        }
        <h1>{lead.data.title}</h1>
        {lead.data.description && <p class="sub">{lead.data.description}</p>}
        <div class="meta">
          <FormattedDate date={lead.data.pubDate} />
          {proj(lead.data.project) && <span>{proj(lead.data.project)!.name}</span>}
        </div>
      </div>
    </div>
  </a>

  {/* 저자별 묶음 — B 에서 가져왔습니다. */}
  {
    sections.map((s) => (
      <section class="band" style={`--who:${s.author.color}`}>
        <header class="band-head">
          <h2 style={`color:${s.author.color}`}>{s.author.name}</h2>
          <span class="tagline">{s.author.tagline}</span>
          <a class="all" href={`/authors/${s.author.id}`}>
            전부 보기
          </a>
        </header>

        <div class="grid">
          {s.items.map((post) => (
            <a class="cell" href={`/posts/${post.id}/`}>
              <PreviewCover
                cover={coverOf(post)}
                alt=""
                ratio="3 / 2"
                sizes="(min-width: 900px) 25vw, 50vw"
                tint={s.author.color}
              />
              <h3>{post.data.title}</h3>
              <div class="meta">
                <FormattedDate date={post.data.pubDate} />
                {proj(post.data.project) && (
                  <span>{proj(post.data.project)!.name}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  {/* 최근 글 — C 에서 가져왔습니다. */}
  <section class="band recent">
    <header class="band-head">
      <h2>최근 글</h2>
      <a class="all" href="/posts">글 {posts.length}편 전부 보기</a>
    </header>

    <div class="rows">
      {
        recent.map((post) => (
          <a class="row" href={`/posts/${post.id}/`}>
            <div class="thumb">
              <PreviewCover
                cover={coverOf(post)}
                alt=""
                ratio="1 / 1"
                sizes="120px"
                tint={who(post.data.author)?.color}
              />
            </div>
            <div class="row-text">
              {who(post.data.author) && (
                <span class="who" style={`color:${who(post.data.author)!.color}`}>
                  {who(post.data.author)!.name}
                </span>
              )}
              <h3>{post.data.title}</h3>
              <span class="date">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <PreviewFooter />


<script>
  /*
    스크롤 효과 셋. 라이브러리 없이 씁니다.

      1. 커버가 화면에 들어올 때 살짝 떠오르기
      2. 첫 꼭지 사진이 스크롤보다 느리게 움직이기 (큰 화면에서만)
      3. 맨 위 진행 막대

    ⚠ 애니메이션을 줄여 둔 사람(prefers-reduced-motion)에게는 아무것도
      걸지 않습니다. 숨기는 클래스를 여기서 붙이기 때문에, 이 스크립트가
      죽어도 지면은 그대로 다 보입니다.
  */
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches

  // 1. 떠오르기
  if (!still && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll('.cell, .row')
    targets.forEach((el) => el.classList.add('reveal'))

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue
          e.target.classList.add('in')
          io.unobserve(e.target) // 한 번 나타난 것은 다시 숨기지 않습니다
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    )
    targets.forEach((el) => io.observe(el))
  }

  // 2·3. 패럴랙스와 진행 막대 — 스크롤마다 계산하지 않고 한 프레임에 한 번만.
  const bar = document.querySelector<HTMLElement>('.progress span')
  const lead = document.querySelector<HTMLElement>('[data-parallax] .frame img')
  const wide = matchMedia('(min-width: 900px)')
  let ticking = false

  function onScroll() {
    if (ticking) return
    ticking = true
    requestAnimationFrame(() => {
      const max = document.body.scrollHeight - innerHeight
      if (bar) {
        bar.style.setProperty('--p', `${max > 0 ? (scrollY / max) * 100 : 0}%`)
      }
      const moving = wide.matches && !still
      // 화면 하나를 다 내려갈 때까지만 움직입니다.
      const run = Math.min(scrollY, innerHeight)

      if (lead) {
        // 사진을 스크롤의 12% 만큼만 따라 내립니다. 더 주면 멀미가 납니다.
        // 틀은 그대로 두고 안쪽 사진만 움직입니다 — 틀을 밀면 빈 틈이 생깁니다.
        lead.style.transform = moving ? `translate3d(0, ${run * 0.12}px, 0)` : ''
      }
      ticking = false
    })
  }

  addEventListener('scroll', onScroll, { passive: true })
  addEventListener('resize', onScroll)
  onScroll()
</script>

<style>
  /* ── 첫 꼭지 ─────────────────────────────────────────── */

  .lead {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* 패럴랙스로 사진이 내려가도 아래가 비지 않게 조금 키워 둡니다. */
  .lead :global(.frame img) {
    height: 118%;
    will-change: transform;
  }

  .lead::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.55) 45%,
      rgba(0, 0, 0, 0.92) 100%
    );
  }

  .lead-text {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1.25rem 2rem;
  }

  .lead h1 {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .lead .sub {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .lead .meta {
    margin-top: 1.25rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /*
    저자 이름. A 에서는 10px 짜리 꼬리표였는데, D 에서는 이게 지면을
    나누는 표지라 키웠습니다.
  */
  .who {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  /* ── 저자 묶음 ───────────────────────────────────────── */

  .band {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 0;
  }

  /*
    저자 표지. 그 묶음을 지나는 동안 위에 붙어 있습니다 — 지금 어느 저자
    구역을 보고 있는지가 계속 보입니다. 헤더(3rem) 바로 아래입니다.

    ⚠ 배경을 깔아야 합니다. 안 깔면 아래 카드가 글자를 뚫고 지나갑니다.
  */
  .band-head {
    position: sticky;
    top: 3rem;
    z-index: 5;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-top: 1.25rem;
    padding-bottom: 0.875rem;
    /* 구분선은 그 저자의 색입니다 (--who 는 section 에서 넘어옵니다) */
    border-top: 2px solid var(--who, var(--border));
    margin-bottom: 1.5rem;
    background-color: var(--bg);
  }

  .band-head h2 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .tagline {
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .all {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--text-dim);
    text-decoration: none;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 0.875rem;
  }

  .cell {
    color: inherit;
    text-decoration: none;
  }

  /* 제목은 두 줄에서 자릅니다 — 길이가 제각각이면 카드 아래가 들쭉날쭉합니다. */
  .cell h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.625rem 0 0.375rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .cell :global(.frame) {
    border-radius: var(--radius-md);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 마우스를 올리면 그 저자 색으로 테두리가 섭니다 */
  .cell:hover :global(.frame) {
    outline: 2px solid var(--who, var(--accent));
    outline-offset: 2px;
  }

  .cell:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── 최근 글 ─────────────────────────────────────────── */

  .rows {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    flex: none;
    width: 5.5rem;
  }

  .thumb :global(.frame) {
    border-radius: var(--radius-md);
  }

  .row .who {
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
  }

  .row h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .row:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .date {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  /* ── 스크롤 ──────────────────────────────────────────── */

  .progress {
    position: fixed;
    top: 3rem;
    left: 0;
    right: 0;
    z-index: 30;
    height: 2px;
    pointer-events: none;
  }

  .progress span {
    display: block;
    width: var(--p, 0%);
    height: 100%;
    background-color: var(--accent);
  }

  /*
    화면에 들어올 때 살짝 떠오릅니다.

    ⚠ 숨기는 것은 스크립트가 켭니다(`.reveal`). CSS 로 처음부터 숨기면
      자바스크립트가 죽었을 때 지면이 통째로 안 보입니다.
  */
  .reveal {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 420ms ease-out,
      transform 420ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .reveal.in {
    opacity: 1;
    transform: none;
  }

  /* 애니메이션을 줄여 둔 사람에게는 아무것도 안 나갑니다. */
  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ── 큰 화면 ─────────────────────────────────────────── */

  @media (min-width: 900px) {
    .lead {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: 1280px;
      margin: 0 auto;
      padding: 2rem 2rem 0;
    }

    .lead::after {
      display: none;
    }

    .lead :global(.frame) {
      aspect-ratio: 4 / 5 !important;
    }

    .lead-text {
      position: static;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 0 0 3rem;
    }

    /*
      제목이 화면에서 사라지지 않게 붙여 둡니다.

      처음에는 사진 옆 **가운데**에 있다가, 스크롤을 내리면 화면 가운데
      쯤에 머뭅니다. 사진 아래쪽이 올라오면 거기서 밀려 내려가 결국
      **사진 아래에 맞춰 멈춥니다.**

      그냥 두면 사진은 아직 화면에 있는데 글자만 위로 빠져나가서, 사진만
      덩그러니 남는 구간이 생깁니다. 그게 싫어서 붙였습니다.

      top 은 "화면 가운데 - 글자 높이의 절반쯤"입니다. 글자 높이를 CSS 가
      모르므로 9rem 으로 어림잡았습니다 — 제목이 세 줄을 넘어가면 이 값을
      키워야 합니다.
    */
    .lead-body {
      position: sticky;
      top: calc(50vh - 9rem);
    }

    .lead .who {
      font-size: 1.125rem;
    }

    .lead h1 {
      font-size: 3.25rem;
      color: var(--text);
    }

    .lead .sub {
      margin-top: 1.25rem;
      font-size: 1.0625rem;
      color: var(--text-dim);
    }

    .lead .meta {
      color: var(--text-faint);
    }

    .band {
      padding: 3.5rem 2rem 0;
    }

    .band-head h2 {
      font-size: 2.25rem;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.25rem 1.625rem;
    }

    /* 폰에서는 3:2 가 딱 맞는데 큰 화면에서는 카드가 작아 보입니다.
       큰 화면에서만 조금 높입니다. */
    .cell :global(.frame) {
      aspect-ratio: 4 / 3 !important;
    }

    .cell h3 {
      font-size: 1.125rem;
      line-height: 1.45;
    }

    /* 최근 글은 두 줄로 — 세로로만 쌓으면 큰 화면에서 한참 내려갑니다. */
    .rows {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2.5rem;
    }

    .thumb {
      width: 7.5rem;
    }

    .row {
      padding: 1.125rem 0;
    }

    .row h3 {
      font-size: 1.0625rem;
    }
  }
</style>
