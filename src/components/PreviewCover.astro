---
/**
 * 시안용 커버 그림.
 *
 * `coverOf()` 가 돌려주는 세 가지를 다 받습니다 — 손으로 고른 `heroImage`,
 * 본문에서 찾아낸 주소, 그리고 **사진이 없는 경우**입니다.
 *
 * 사진이 없으면 그림 파일 대신 **저자 색 판**을 그립니다. 파일로 만들면
 * 한 장을 다크·라이트 양쪽에 써야 해서 한쪽에서 반드시 튑니다 (어두운
 * 판을 흰 배경에 놓으면 검은 사각형이 됩니다). CSS 로 그리면 테마마다
 * 밝기를 따로 맞출 수 있고, 저자마다 색이 달라 33편이 다 같아 보이지도
 * 않습니다.
 *
 * ⚠ 판에는 글자를 넣지 않습니다. 첫 꼭지처럼 커버 위에 제목을 얹는
 *   자리에서 겹칩니다 (기본 커버에 글자를 넣었다가 뺀 이유와 같습니다).
 */
import { Image } from 'astro:assets'
import type { Cover } from '../lib/cover'

interface Props {
  cover: Cover
  alt: string
  /** 잘라낼 비율. 예: '3 / 4' */
  ratio: string
  sizes?: string
  /** 사진이 없을 때 판에 깔 색. 저자 색을 넘깁니다. */
  tint?: string
}

const { cover, alt, ratio, sizes = '100vw', tint } = Astro.props as Props
---

<div
  class:list={['frame', cover.kind === 'none' && 'blank']}
  style={`aspect-ratio:${ratio}${tint ? `;color:${tint}` : ''}`}
>
  {
    cover.kind === 'asset' ? (
      <Image src={cover.src} alt={alt} widths={[480, 960, 1440]} sizes={sizes} />
    ) : cover.kind === 'file' ? (
      <img src={cover.src} alt={alt} loading="lazy" decoding="async" />
    ) : null
  }
</div>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    background-color: var(--surface);
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /*
      위쪽을 남기고 자릅니다. 코드 캡처와 앱 화면은 위에 정보가 몰려
      있어서, 가운데 기준으로 자르면 제목 줄과 상단 바가 날아갑니다.
    */
    object-fit: cover;
    object-position: top center;
  }

  /* 사진이 없는 칸 — 저자 색을 옅게 깐 판.
     tint 를 안 넘기면 흐린 회색으로 떨어집니다. */
  .blank {
    background-color: var(--surface);
    color: var(--text-faint);
  }

  .blank::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, currentColor, transparent 72%);
    opacity: 0.22;
  }

  /* 지뢰찾기 판을 닮은 격자를 아주 옅게 */
  .blank::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 22% 22%;
    opacity: 0.12;
  }

  :global(html[data-theme='light']) .blank::before {
    opacity: 0.16;
  }
</style>
