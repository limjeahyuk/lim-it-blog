---
import Icon from './Icon.astro'

interface Props {
  /** 지금 보고 있는 태그 (있으면 강조) */
  current?: string
}

const { current } = Astro.props as Props
---

<!-- 태그 목록은 접어뒀습니다. 옮겨온 글 대부분이 태그가 없어서
     사이드바가 몇 개 안 되는 태그로만 길어졌습니다.
     `/tags/<태그>` 페이지는 그대로 살아 있습니다. -->
<div class="wrap">
  <div class="side-title"><Icon name="label" size={17} /> Tags</div>
  <div class="list">
    <a href="/" data-active={current === undefined}>All</a>
  </div>
</div>

<style>
  /* 좁은 화면에서는 가로 스크롤 한 줄.
     화면 양끝까지 흘려 보내서 「옆으로 더 있다」가 보이게 합니다 —
     안쪽에서 딱 끊기면 그게 끝인 줄 압니다. */
  .list {
    display: flex;
    margin-bottom: 1.5rem;
    margin-inline: -1rem;
    padding-inline: 1rem;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .list a {
    display: block;
    padding: 0.45rem 1rem;
    margin: 0.25rem 0;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .list a:hover {
    background-color: var(--card);
  }

  .list a[data-active='true'] {
    color: var(--text);
    background-color: var(--card);
  }

  @media (min-width: 1024px) {
    .list {
      display: block;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .list a {
      padding-block: 0.25rem;
    }
  }
</style>
