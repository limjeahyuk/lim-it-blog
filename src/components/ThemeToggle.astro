---

<button id="theme-toggle" type="button" aria-label="테마 전환">
  <span class="dark-only">🌙</span>
  <span class="light-only">☀️</span>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }

  :global(html[data-theme='dark']) .light-only {
    display: none;
  }

  :global(html[data-theme='light']) .dark-only {
    display: none;
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('theme', next)
  })
</script>
