---
import Icon from './Icon.astro'
---

{/* 해·달은 limSystem 에 없어서 icons-extra 에 따로 넣었습니다.
    지금 테마에 해당하는 쪽만 CSS 로 보여줍니다. */}
<button id="theme-toggle" type="button" aria-label="테마 전환">
  <span class="dark-only"><Icon name="moon" size={18} /></span>
  <span class="light-only"><Icon name="sun" size={18} /></span>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--text-dim);
    line-height: 1;
  }

  button:hover {
    color: var(--text);
  }

  button span {
    display: inline-flex;
  }

  :global(html[data-theme='dark']) .light-only {
    display: none;
  }

  :global(html[data-theme='light']) .dark-only {
    display: none;
  }
</style>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next =
      document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    localStorage.setItem('theme', next)
  })
</script>
