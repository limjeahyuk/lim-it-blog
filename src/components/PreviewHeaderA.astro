---
/**
 * 헤더 시안 1 — 지금 것을 그대로 두고 이름과 검색만.
 *
 * 바뀐 것: 이름이 lim's World 로, 오른쪽 끝에 돋보기 하나.
 * 높이도 지금과 같은 3rem 이라 지면이 밀리지 않습니다.
 *
 * ⚠ 임시입니다. 헤더를 고르고 나면 Header.astro 로 옮기고 지웁니다.
 */
import Icon from './Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import { SITE_TITLE } from '../consts'
---

<header>
  <div class="bar">
    <a class="logo" href="/">{SITE_TITLE}</a>
    <nav>
      <a href="/authors">Editors</a>
      <a href="/posts">Posts</a>
      <a href="/projects">Live Service</a>
    </nav>
    <div class="tools">
      <a class="icon" href="/search" aria-label="검색"><Icon name="search" size={18} /></a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .logo {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
  }

  nav {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  nav a {
    font-size: 0.875rem;
    color: var(--text-dim);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon {
    display: flex;
    color: var(--text-dim);
  }

  .icon:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .bar {
      padding: 0 1rem;
      gap: 0.75rem;
    }
    nav {
      gap: 0.75rem;
    }
    nav a {
      font-size: 0.8125rem;
    }
  }
</style>
