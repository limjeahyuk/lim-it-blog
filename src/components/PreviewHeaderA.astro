---
/**
 * 헤더 시안 1 — 이름 하나 + 햄버거 하나.
 *
 * 오른쪽에 흩어져 있던 다섯 개(Editors·Posts·Live Service·검색·테마)를
 * 버튼 하나로 접었습니다. 누르면 옆에서 판이 나옵니다 —
 * 폰은 화면 전체, 큰 화면은 오른쪽 절반.
 *
 * 아래에 읽기 진행 막대가 붙습니다. 지면이 길어서 어디쯤인지 보여줍니다.
 *
 * ⚠ 임시입니다. 헤더를 고르고 나면 Header.astro 로 옮기고 지웁니다.
 */
import Icon from './Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import { AUTHORS, OWNER, PROJECTS, SITE_TITLE } from '../consts'
import { countByAuthor, getPublishedPosts } from '../lib/posts'

const posts = await getPublishedPosts()
const counts = countByAuthor(posts)
---

<header>
  <div class="bar">
    <a class="logo" href="/">{SITE_TITLE}</a>

    <button
      class="burger"
      type="button"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  {/* 읽기 진행 막대 — 헤더 바로 아래 */}
  <div class="progress" aria-hidden="true"><span></span></div>
</header>

<!-- 판 뒤를 덮는 그늘. 큰 화면에서 바깥을 눌러 닫는 자리이기도 합니다. -->
<div class="scrim" hidden></div>

<aside id="menu" class="panel" hidden aria-label="메뉴">
  <div class="panel-top">
    <a class="logo" href="/">{SITE_TITLE}</a>
    <div class="tools">
      <ThemeToggle />
      <button class="close" type="button" aria-label="메뉴 닫기">
        <Icon name="close" size={22} />
      </button>
    </div>
  </div>

  <form class="find" action="/search" method="get" role="search">
    <span class="ico"><Icon name="search" size={20} /></span>
    <label class="sr" for="menu-q">검색어</label>
    <input id="menu-q" type="search" name="q" placeholder="검색어 입력" autocomplete="off" />
  </form>

  <nav class="big">
    <a class="head" href="/authors">EDITORS</a>
    <ul>
      {
        AUTHORS.map((a) => (
          <li>
            <a href={`/authors/${a.id}`} style={`color:${a.color}`}>
              {a.name}
              <span class="n">{counts.get(a.id) ?? 0}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="head" href="/posts">POSTS<span class="n">{posts.length}</span></a>

    <a class="head" href="/projects">LIVE SERVICE</a>
    <ul>
      {
        PROJECTS.map((p) => (
          <li>
            <a href={`/projects/${p.id}`}>{p.name}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="panel-foot">
    <a href={`https://github.com/${OWNER.github}`}>GITHUB</a>
    <a href={`mailto:${OWNER.email}`}>EMAIL</a>
    <a href="/rss.xml">RSS</a>
  </div>
</aside>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .logo {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--text);
  }

  /* 햄버거 — 줄 세 개를 직접 그립니다 (아이콘 팩에 없습니다) */
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .burger span {
    display: block;
    height: 2px;
    background-color: var(--text);
    border-radius: 1px;
  }

  .burger span:nth-child(1) {
    width: 22px;
  }
  .burger span:nth-child(2) {
    width: 22px;
  }
  .burger span:nth-child(3) {
    width: 14px;
  }

  .progress {
    height: 2px;
    background-color: transparent;
  }

  .progress span {
    display: block;
    width: var(--p, 0%);
    height: 100%;
    background-color: var(--accent);
  }

  /* ── 메뉴 판 ─────────────────────────────────────────── */

  .scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background-color: rgba(0, 0, 0, 0.45);
  }

  .panel {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    bottom: 0;
    /* 폰에서는 화면을 다 씁니다 */
    width: 100%;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1.25rem 1.25rem;
    background-color: var(--bg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .panel[hidden],
  .scrim[hidden] {
    display: none;
  }

  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.25rem;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .close {
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .find {
    position: relative;
    display: flex;
    align-items: center;
    margin: 1.5rem 0 0.5rem;
    border-bottom: 2px solid var(--text);
  }

  .ico {
    display: flex;
    color: var(--text);
  }

  .find input {
    width: 100%;
    padding: 0.625rem 0.5rem;
    border: 0;
    background: none;
    color: var(--text);
    /* ⚠ 16px 미만이면 iOS 사파리가 탭할 때 화면을 확대합니다 */
    font-size: 1.0625rem;
  }

  .find input:focus {
    outline: none;
  }

  .big {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .big .head {
    padding: 0.5rem 0;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  .big ul {
    margin: 0 0 0.75rem;
    padding: 0 0 0 0.875rem;
    list-style: none;
  }

  .big li a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.3125rem 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
    text-decoration: none;
  }

  .n {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-faint);
  }

  .head .n {
    margin-left: 0.5rem;
  }

  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .panel-foot a {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-decoration: none;
  }

  .panel-foot a + a {
    border-left: 1px solid var(--border);
    padding-left: 0.75rem;
  }

  @media (min-width: 900px) {
    /* 큰 화면에서는 오른쪽 절반만 덮습니다 */
    .panel {
      width: 50%;
      min-width: 24rem;
      padding: 1rem 2.5rem 2rem;
      border-left: 1px solid var(--border);
    }

    .big .head {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  /*
    메뉴 판 여닫기와 읽기 진행 막대.

    ⚠ 판이 열려 있는 동안 뒤 지면이 같이 스크롤되면 안 됩니다. body 를
      잠그고, 닫을 때 원래 자리로 돌려놓습니다.
  */
  const burger = document.querySelector<HTMLButtonElement>('.burger')!
  const panel = document.querySelector<HTMLElement>('.panel')!
  const scrim = document.querySelector<HTMLElement>('.scrim')!
  const close = document.querySelector<HTMLButtonElement>('.close')!
  const field = document.querySelector<HTMLInputElement>('#menu-q')!

  function setOpen(open: boolean) {
    panel.hidden = !open
    scrim.hidden = !open
    burger.setAttribute('aria-expanded', String(open))
    document.documentElement.style.overflow = open ? 'hidden' : ''
    if (open) field.focus({ preventScroll: true })
    else burger.focus({ preventScroll: true })
  }

  burger.addEventListener('click', () => setOpen(true))
  close.addEventListener('click', () => setOpen(false))
  scrim.addEventListener('click', () => setOpen(false))

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) setOpen(false)
  })

  // 진행 막대 — 스크롤마다 계산하지 않고 한 프레임에 한 번만.
  const bar = document.querySelector<HTMLElement>('.progress span')!
  let ticking = false

  function onScroll() {
    if (ticking) return
    ticking = true
    requestAnimationFrame(() => {
      const max = document.body.scrollHeight - innerHeight
      bar.style.setProperty('--p', `${max > 0 ? (scrollY / max) * 100 : 0}%`)
      ticking = false
    })
  }

  addEventListener('scroll', onScroll, { passive: true })
  addEventListener('resize', onScroll)
  onScroll()
</script>
