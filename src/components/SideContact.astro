---
import Icon from './Icon.astro'
import { OWNER } from '../consts'
import type { IconName } from '../lib/icon-names'

const links: { label: string; href: string; icon: IconName }[] = [
  {
    label: 'github',
    href: `https://github.com/${OWNER.github}`,
    icon: 'folder-code',
  },
  { label: 'email', href: `mailto:${OWNER.email}`, icon: 'at' },
]

const year = new Date().getFullYear()
---

<div class="wrap">
  <div class="side-title"><Icon name="chat-circle-dots" size={17} /> Contact</div>
  <div class="card content">
    {
      links.map((link) => (
        <a class="row" href={link.href} target="_blank" rel="noopener">
          <Icon name={link.icon} size={16} />
          {link.label}
        </a>
      ))
    }
  </div>
  <div class="copy">© {OWNER.name} {year}</div>
</div>

<style>
  .content {
    padding: 0.5rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-dim);
  }

  .row:hover {
    background-color: var(--surface);
    color: var(--text);
  }

  .copy {
    padding: 0.75rem 0.25rem;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
</style>
