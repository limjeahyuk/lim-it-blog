---
import BaseHead from './BaseHead.astro'
import Header from './Header.astro'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  type?: 'website' | 'article'
  pubDate?: Date
}

const head = Astro.props as Props
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
