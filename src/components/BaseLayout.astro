---
import BaseHead from './BaseHead.astro'
import Header from './Header.astro'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  authorName?: string
  /**
   * 헤더를 이 레이아웃이 그리지 않습니다.
   * 헤더 시안 페이지가 자기 헤더를 직접 그릴 때만 씁니다 (임시).
   */
  hideHeader?: boolean
}

const { hideHeader = false, ...head } = Astro.props as Props
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    {!hideHeader && <Header />}
    <main>
      <slot />
    </main>

    {/* 배포된 사이트에서만 붙입니다. 로컬 개발 중에는 아무것도 안 나갑니다. */}
    {
      import.meta.env.PROD && (
        <>
          <Analytics />
          <SpeedInsights />
        </>
      )
    }
  </body>
</html>
