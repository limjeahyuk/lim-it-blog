---
import BaseHead from './BaseHead.astro'
import Header from './Header.astro'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'

interface Props {
  title: string
  description: string
  /** 공유 카드 사진. `/images/…` 공개 경로입니다. */
  image?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  authorName?: string
}

const head = Astro.props as Props
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>

    {/* 배포된 사이트에서만 붙입니다. 로컬 개발 중에는 아무것도 안 나갑니다. */}
    {
      import.meta.env.PROD && (
        <>
          <Analytics />
          <SpeedInsights />
        </>
      )
    }
  </body>
</html>
