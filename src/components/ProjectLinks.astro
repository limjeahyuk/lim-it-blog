---
/**
 * 프로젝트의 받는 곳 버튼 줄 — /projects/<id> 와 /about 이 같이 씁니다.
 *
 * ⚠ 2026-09-08 시안부터 주 버튼은 **프로젝트 색이 아니라 강조색**입니다.
 *   프로젝트 색으로 칠하면 버튼이 프로젝트마다 다른 색이 되어, 같은 자리의
 *   같은 동작("지금 해보기")이 지면마다 다르게 읽혔습니다. 프로젝트 색은
 *   알약과 Service 목록의 점에 그대로 남아 있습니다.
 *   글자는 --accent-fg 입니다 — 다크는 밝은 파랑 위 어두운 글자, 라이트는
 *   진한 파랑 위 흰 글자로 갈립니다 (global.css).
 */
import Icon from './Icon.astro'
import type { Project } from '../consts'
import type { IconName } from '../lib/icon-names'

interface Props {
  project: Project
  /** 끝에 「소개 보기」를 붙입니다 */
  about?: boolean
}

const { project, about } = Astro.props

/** 링크 종류별 아이콘. consts.ts 의 links[].kind 와 짝입니다. */
const LINK_ICON: Record<string, IconName> = {
  web: 'play-circle',
  appstore: 'download',
  support: 'circle-question',
}
---

<div class="cta">
  {
    project.links.map((link) => (
      <a class="btn primary" href={link.href} target="_blank" rel="noopener">
        <Icon name={LINK_ICON[link.kind] ?? 'link-external'} size={17} />
        {link.label}
      </a>
    ))
  }
  {about && <a class="btn ghost" href={`/projects/${project.id}/about`}>소개 보기</a>}
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.625rem 1.125rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .primary {
    color: var(--accent-fg);
    background-color: var(--accent);
  }

  .primary:hover {
    opacity: 0.85;
  }

  .ghost {
    border: 1px solid var(--border);
    color: var(--text-dim);
  }

  .ghost:hover {
    color: var(--text);
    background-color: var(--surface);
  }
</style>
