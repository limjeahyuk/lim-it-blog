---
import { SITE_TITLE } from '../consts'
import ThemeToggle from './ThemeToggle.astro'
---

<header>
  <div class="container">
    <a class="logo" href="/" aria-label={SITE_TITLE}>{SITE_TITLE}</a>
    <div class="nav">
      <ThemeToggle />
      <ul>
        <li><a href="/authors">Editors</a></li>
        <li><a href="/posts">Posts</a></li>
        <li><a href="/projects">Live Service</a></li>
      </ul>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--bg);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 3rem;
  }

  .logo {
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .nav {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-shrink: 0;
  }

  .nav ul {
    display: flex;
    flex-direction: row;
    margin: 0;
    list-style: none;
  }

  .nav ul li {
    display: block;
    margin-left: 1rem;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .nav ul li a:hover {
    color: var(--text);
  }
</style>
