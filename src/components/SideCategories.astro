---
/**
 * 카테고리 트리. 이 블로그의 1차 분류라 사이드바 맨 위에 옵니다.
 *
 * 트리는 consts.ts 의 id 경로에서 만듭니다 — 'study/react' 는 'study' 아래.
 * 글이 0개인 카테고리는 숨습니다 (자리는 잡아두되 빈 줄은 안 보이게).
 */
import Icon from './Icon.astro'
import { CATEGORIES, categoryDepth } from '../consts'
import { countByCategory, getPublishedPosts } from '../lib/posts'

interface Props {
  /** 지금 보고 있는 카테고리 (있으면 강조) */
  current?: string
}

const { current } = Astro.props as Props

const posts = await getPublishedPosts()
const counts = countByCategory(posts)

const rows = CATEGORIES.filter((c) => (counts.get(c.id) ?? 0) > 0).map((c) => ({
  ...c,
  depth: categoryDepth(c.id),
  count: counts.get(c.id) ?? 0,
  /** 지금 보는 글이 이 카테고리 안(또는 아래)인지 */
  on: current === c.id || current?.startsWith(`${c.id}/`),
}))
---

<div class="wrap">
  <div class="side-title"><Icon name="folder-folders" size={17} /> Categories</div>
  <div class="list">
    <a href="/" data-active={current === undefined} data-depth="0">
      <span class="name">All</span>
      <span class="count">{posts.length}</span>
    </a>
    {
      rows.map((row) => (
        <a
          href={`/categories/${row.id}`}
          data-active={current === row.id}
          data-on={row.on}
          data-depth={row.depth}
        >
          <span class="name">{row.label}</span>
          <span class="count">{row.count}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  /* 좁은 화면에서는 가로 스크롤 한 줄. 태그 목록과 같은 규칙입니다 —
     화면 양끝까지 흘려서 옆으로 더 있다는 걸 보이게 합니다. */
  .list {
    display: flex;
    margin-bottom: 1.5rem;
    margin-inline: -1rem;
    padding-inline: 1rem;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .list a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    margin: 0.125rem 0;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .list a:hover {
    background-color: var(--card);
    color: var(--text-dim);
  }

  .list a[data-on='true'] {
    color: var(--text-dim);
  }

  .list a[data-active='true'] {
    color: var(--text);
    background-color: var(--card);
  }

  .count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  /* 좁은 화면의 한 줄 목록에서는 개수와 들여쓰기가 방해만 됩니다. */
  .count {
    display: none;
  }

  @media (min-width: 1024px) {
    .list {
      display: block;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .list a {
      padding-block: 0.25rem;
    }

    .count {
      display: inline;
    }

    .list a[data-depth='1'] {
      padding-left: 1.5rem;
      font-size: 0.8125rem;
    }
  }
</style>
