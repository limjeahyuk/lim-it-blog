---
import BaseLayout from '../../components/BaseLayout.astro'
import FeedLayout from '../../components/FeedLayout.astro'
import Icon from '../../components/Icon.astro'
import PostCard from '../../components/PostCard.astro'
import { countByTag, getPublishedPosts, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return countByTag(posts).map(([tag]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }))
}

type Props = { tag: string; posts: Post[] }

const { tag, posts } = Astro.props as Props
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 붙은 글`}>
  <FeedLayout currentTag={tag}>
    <div class="feed-header">
      <span class="title-ico"><Icon name="label" size={17} /> {tag}</span>
      <span class="count">{posts.length}</span>
    </div>

    {posts.map((post) => <PostCard post={post} />)}
  </FeedLayout>
</BaseLayout>

<style>
  .feed-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .count {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }
</style>
