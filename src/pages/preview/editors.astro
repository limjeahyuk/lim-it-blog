---
/**
 * 위지윅 편집기 시안 — 실제로 쳐 보고 고르는 자리입니다.
 *
 * 셋 다 같은 마크다운으로 시작합니다. 밑의 "마크다운 보기" 를 누르면
 * 지금 내용이 어떤 마크다운으로 저장될지 나옵니다 — **글 128편이
 * 마크다운 파일이라 이 왕복이 제일 중요한 판단 근거입니다.**
 *
 * ⚠ 고르고 나면 이 파일과 robots.txt 의 Disallow, 안 고른 패키지를
 *   같이 지웁니다.
 */
import BaseLayout from '../../components/BaseLayout.astro'

const SAMPLE = `## 서고를 새로 짰습니다

홈에서 "전체보기" 를 누르면 옛 지면이 나왔습니다.

- 거르기는 브라우저가 합니다
- 썸네일은 640px 아래에서 뺍니다

| 화면 | 무엇을 |
| --- | --- |
| \`/\` | 최신 열여섯 편 |
| \`/posts\` | 서고 |

> 상자를 겹겹이 쌓는 것보다 큰 제목과 여백이 낫습니다.

\`\`\`js
const recent = posts.slice(0, 6)
\`\`\`

![전투 화면](/images/gridbrawl-ai-aim/battle.png)
`

const panes = [
  {
    id: 'tiptap',
    name: 'Tiptap',
    now: true,
    made: 'Tiptap GmbH',
    note: '지금 쓰는 것. ProseMirror 위에 직접 얹어 쓰는 방식이라 자유롭지만, 툴바·색·형광펜을 전부 손으로 만들어야 합니다.',
    tags: ['MIT', '마크다운 왕복', '툴바 직접 제작', '확장 자유'],
  },
  {
    id: 'toast',
    name: 'Toast UI Editor',
    made: 'NHN',
    note: '마크다운이 1급 시민입니다. 왼쪽 원문·오른쪽 미리보기로 볼 수 있고, 위지윅과 마크다운을 버튼 하나로 오갑니다. 표 편집이 제일 셉니다.',
    tags: ['MIT', '마크다운 네이티브', '원문/위지윅 토글', '표 병합', '한국어 UI'],
  },
  {
    id: 'milkdown',
    name: 'Milkdown (Crepe)',
    made: 'Mirone',
    note: '노션처럼 씁니다. 슬래시(/) 메뉴, 블록 손잡이, 드래그 정렬, 코드블록 문법 강조가 처음부터 들어 있습니다. Tiptap 과 같은 ProseMirror 기반입니다.',
    tags: ['MIT', '마크다운 네이티브', '슬래시 메뉴', '블록 드래그', '수식(LaTeX)'],
  },
]
---

<BaseLayout title="편집기 시안" description="위지윅 편집기 비교">
  <div class="wrap">
    <header class="head">
      <h1>위지윅 편집기 시안</h1>
      <p>
        셋 다 아래 칸에서 직접 쳐 보실 수 있습니다. <b>폰에서 한글 입력이 안 끊기는지</b>가
        제일 중요합니다 — Decap 기본 리치 텍스트를 못 쓴 이유가 그것이었습니다.
      </p>
      <p>
        <b>마크다운 보기</b>를 누르면 지금 내용이 어떤 마크다운으로 저장될지 나옵니다.
        글 128편이 마크다운 파일이라, 원본을 얼마나 안 건드리는지가 판단 근거입니다.
      </p>
    </header>

    {
      panes.map((p) => (
        <section class="pane">
          <header class="pane-head">
            <h2>
              {p.name}
              {p.now && <span class="now">지금</span>}
            </h2>
            <span class="made">{p.made}</span>
          </header>

          <p class="note">{p.note}</p>

          <ul class="tags">
            {p.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>

          <p class="diff" id={`diff-${p.id}`}>왕복 검사 중…</p>

          <div class="host" id={`host-${p.id}`} />

          <div class="out">
            <button type="button" data-md={p.id}>
              마크다운 보기
            </button>
            <pre id={`md-${p.id}`} hidden />
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script define:vars={{ SAMPLE }}>
  window.__SAMPLE__ = SAMPLE
</script>

<script>
  import { Editor } from '@tiptap/core'
  import { Markdown } from '@tiptap/markdown'
  import Image from '@tiptap/extension-image'
  import { TableKit } from '@tiptap/extension-table'
  import StarterKit from '@tiptap/starter-kit'

  import ToastEditor from '@toast-ui/editor'
  import '@toast-ui/editor/dist/toastui-editor.css'
  import '@toast-ui/editor/dist/theme/toastui-editor-dark.css'
  import '@toast-ui/editor/dist/i18n/ko-kr'

  import { Crepe } from '@milkdown/crepe'
  import '@milkdown/crepe/theme/common/style.css'
  import '@milkdown/crepe/theme/frame.css'

  const sample = (window as any).__SAMPLE__ as string
  const md: Record<string, () => string> = {}

  /* ── Tiptap ─────────────────────────────────────────── */
  const tiptap = new Editor({
    element: document.querySelector('#host-tiptap')!,
    extensions: [StarterKit, Markdown, TableKit, Image],
    content: sample,
    contentType: 'markdown',
  })
  md.tiptap = () => (tiptap as any).getMarkdown()

  /* ── Toast UI ───────────────────────────────────────── */
  const toast = new ToastEditor({
    el: document.querySelector('#host-toast')!,
    height: '420px',
    initialEditType: 'wysiwyg',
    previewStyle: 'tab',
    language: 'ko-KR',
    initialValue: sample,
    usageStatistics: false,
    /* Toast 는 자기 테마를 따로 씁니다 — 지면 테마를 넘겨 줍니다 */
    theme: document.documentElement.dataset.theme === 'light' ? 'default' : 'dark',
  })
  md.toast = () => toast.getMarkdown()

  /* ── Milkdown (Crepe) ───────────────────────────────── */
  const crepe = new Crepe({
    root: document.querySelector('#host-milkdown')!,
    defaultValue: sample,
  })
  /* create() 는 비동기입니다 — 끝난 뒤에 왕복 검사를 돌려야 합니다 */
  const crepeReady = crepe.create()
  md.milkdown = () => crepe.getMarkdown()

  /*
    왕복 검사. 위 SAMPLE 을 넣었다 도로 꺼내서 원본과 대 봅니다 —
    글 128편이 마크다운 파일이라 여기서 갈립니다.
  */
  function report(id: string) {
    const out = md[id]().trim()
    const src = sample.trim()
    const el = document.querySelector<HTMLElement>(`#diff-${id}`)!

    if (out === src) {
      el.textContent = '원본 그대로 돌아옵니다.'
      el.dataset.ok = 'yes'
      return
    }

    const changed: string[] = []
    if (/^\* /m.test(out) && /^- /m.test(src)) changed.push('목록 표시가 - 에서 * 로')
    if (/\| -{4,}/.test(out) && !/\| -{4,}/.test(src)) changed.push('표 칸을 공백으로 맞춰 다시 씀')
    const a = (out.match(/!\[([^\]]*)\]/) || [])[1]
    const b = (src.match(/!\[([^\]]*)\]/) || [])[1]
    if (a !== b) changed.push(`사진 설명(alt)이 "${b}" 에서 "${a}" 로`)
    if (!changed.length) changed.push('빈 줄 수가 달라짐')

    el.textContent = `원본과 달라집니다 — ${changed.join(' · ')}.`
    el.dataset.ok = 'no'
  }

  report('tiptap')
  report('toast')
  crepeReady.then(() => report('milkdown'))

  /* ── 마크다운 보기 ──────────────────────────────────── */
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-md]')) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.md!
      const out = document.querySelector<HTMLElement>(`#md-${id}`)!
      if (!out.hidden) {
        out.hidden = true
        btn.textContent = '마크다운 보기'
        return
      }
      out.textContent = md[id]()
      out.hidden = false
      btn.textContent = '접기'
    })
  }
</script>

<style is:global>
  /* 편집기들이 자기 CSS 를 들고 오므로, 지면 색에만 맞춰 줍니다. */
  .host .ProseMirror,
  .host .toastui-editor-contents,
  .host .milkdown {
    color: var(--text);
  }

  .host .toastui-editor-defaultUI {
    border-radius: var(--radius-md);
  }

  .host .milkdown {
    --crepe-color-background: var(--card);
    --crepe-color-on-background: var(--text);
    height: 420px;
    overflow-y: auto;
  }

  /* Crepe 기본 여백이 60/120px 이라 폰에서 글자 세 개씩 끊깁니다 */
  .host .milkdown .ProseMirror {
    padding: 1.25rem;
  }

  @media (min-width: 900px) {
    .host .milkdown .ProseMirror {
      padding: 2rem 3rem;
    }
  }
</style>

<style>
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .head h1 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .head p {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .pane {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .pane-head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .pane-head h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .now {
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background-color: var(--accent-text);
    color: var(--card);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .made {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .note {
    margin: 0.625rem 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .diff {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-faint);
  }

  .diff[data-ok='yes'] {
    color: var(--accent-text);
  }

  .host {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--card);
    overflow: hidden;
  }

  .out {
    margin-top: 0.75rem;
  }

  .out button {
    padding: 0.4375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    color: var(--text-dim);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .out pre {
    margin: 0.75rem 0 0;
    padding: 0.875rem;
    border-radius: var(--radius-md);
    background-color: var(--surface-2);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>
