---
/**
 * 시안 B — 롱블랙식.
 *
 * 오늘의 한 편을 크게 놓고, 그 아래는 묶음(저자·프로젝트)마다 가로로
 * 흐르는 줄을 답니다. 롱블랙은 하루 한 편을 세우고 아래에 주제 묶음을
 * 가로 스크롤로 붙입니다 — 글이 124편이라 그 구조가 잘 맞습니다.
 *
 * ⚠ 임시 페이지입니다. 고르고 나면 지웁니다.
 */
import BaseLayout from '../../components/BaseLayout.astro'
import FormattedDate from '../../components/FormattedDate.astro'
import PreviewCover from '../../components/PreviewCover.astro'
import PreviewNav from '../../components/PreviewNav.astro'
import { AUTHORS, PROJECTS, getAuthor } from '../../consts'
import { coverOf } from '../../lib/cover'
import { getPublishedPosts, postsByAuthor } from '../../lib/posts'

const posts = await getPublishedPosts()
const lead = posts[0]

/** 묶음 — 저자별로 하나씩, 그리고 프로젝트 글을 모은 줄 하나. */
const rails = [
  ...AUTHORS.map((a) => ({
    key: a.id,
    title: a.name,
    note: a.tagline,
    href: `/authors/${a.id}`,
    items: postsByAuthor(posts, a.id)
      .filter((p) => p.id !== lead.id)
      .slice(0, 8),
  })),
  {
    key: 'projects',
    title: '만든 것',
    note: PROJECTS.map((p) => p.name).join(' · '),
    href: '/projects',
    items: posts.filter((p) => p.data.project && p.id !== lead.id).slice(0, 8),
  },
].filter((r) => r.items.length > 0)

const who = (id?: string) => (id ? getAuthor(id) : undefined)
---

<BaseLayout title="시안 B" description="홈 디자인 시안 B">
  <PreviewNav current="b" />

  <div class="wrap">
    <p class="today">오늘의 글</p>

    <a class="lead" href={`/posts/${lead.id}/`}>
      <PreviewCover cover={coverOf(lead)} alt="" ratio="4 / 3" />
      <h1>{lead.data.title}</h1>
      {lead.data.description && <p class="sub">{lead.data.description}</p>}
      <div class="meta">
        {
          who(lead.data.author) && (
            <span style={`color:${who(lead.data.author)!.color}`}>
              {who(lead.data.author)!.name}
            </span>
          )
        }
        <FormattedDate date={lead.data.pubDate} />
      </div>
    </a>

    {
      rails.map((rail) => (
        <section class="rail">
          <header>
            <h2>{rail.title}</h2>
            <span class="note">{rail.note}</span>
            <a class="all" href={rail.href}>
              더 보기
            </a>
          </header>

          <div class="track">
            {rail.items.map((post) => (
              <a class="card" href={`/posts/${post.id}/`}>
                <PreviewCover
                  cover={coverOf(post)}
                  alt=""
                  ratio="1 / 1"
                  sizes="220px"
                />
                <h3>{post.data.title}</h3>
                <span class="date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <a class="more" href="/posts">글 {posts.length}편 전부 보기 →</a>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .today {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .lead {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .lead :global(.frame) {
    border-radius: var(--radius-card);
  }

  .lead h1 {
    margin: 1.25rem 0 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .lead .sub {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .rail {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .rail header {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 1rem;
  }

  .rail h2 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .note {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .all {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--text-dim);
    text-decoration: none;
  }

  /* 가로로 흐르는 줄. 화면 끝까지 흘려서 옆에 더 있다는 걸 보이게 합니다. */
  .track {
    display: flex;
    gap: 0.875rem;
    margin-inline: -1rem;
    padding-inline: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .card {
    flex: none;
    width: 13.75rem;
    scroll-snap-align: start;
    color: inherit;
    text-decoration: none;
  }

  .card :global(.frame) {
    border-radius: var(--radius-lg);
  }

  .card h3 {
    margin: 0.625rem 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .more {
    display: block;
    margin-top: 3rem;
    font-size: 0.9375rem;
    color: var(--text-dim);
    text-decoration: none;
  }

  @media (min-width: 700px) {
    .wrap {
      padding: 2.5rem 1.5rem 4rem;
    }

    .lead :global(.frame) {
      aspect-ratio: 21 / 9 !important;
    }

    .lead h1 {
      font-size: 2.5rem;
      max-width: 22ch;
    }
  }
</style>
