---
import BaseLayout from '../../components/BaseLayout.astro'
import FeedLayout from '../../components/FeedLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { PROJECTS } from '../../consts'
import { getPublishedPosts, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return PROJECTS.map((project) => ({
    params: { project: project.id },
    props: {
      project,
      posts: posts.filter((p) => p.data.project === project.id),
    },
  }))
}

type Props = {
  project: (typeof PROJECTS)[number]
  posts: Post[]
}

const { project, posts } = Astro.props as Props
---

<BaseLayout
  title={project.name}
  description={`${project.name} — ${project.tagline}`}
>
  <FeedLayout>
    <div class="feed-header">
      <span>🎮 Works</span>
      <span class="sep">/</span>
      <span>{project.name}</span>
    </div>

    <div class="card head">
      <span class="bar" style={`background-color:${project.color}`}></span>
      <div class="content">
        <div class="top">
          <span
            class="pill-category"
            style={`background-color:${project.color}`}
          >
            {project.name}
          </span>
          {project.active && <span class="live">LIVE</span>}
        </div>
        <h1>{project.tagline}</h1>
        <p class="stack">{project.platform} · {project.stack.join(', ')}</p>
      </div>
    </div>

    <div class="list-title">
      <span>📚 Devlog</span>
      <span class="count">{posts.length}</span>
    </div>

    {
      posts.length === 0 ? (
        <p class="empty">아직 이 프로젝트의 글이 없습니다.</p>
      ) : (
        posts.map((post) => <PostCard post={post} />)
      )
    }
  </FeedLayout>
</BaseLayout>

<style>
  .feed-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .sep {
    color: var(--text-faint);
  }

  .head {
    position: relative;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
  }

  .content {
    padding: 1.25rem 1.5rem;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }

  .live {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    color: var(--pill-fg);
    background-color: var(--text-dim);
  }

  h1 {
    font-size: 1.25rem;
    line-height: 1.6;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .stack {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .list-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .count {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .empty {
    padding: 1rem 0.25rem;
    color: var(--text-faint);
    font-size: 0.9375rem;
  }
</style>
