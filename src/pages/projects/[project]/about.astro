---
/**
 * 프로젝트 소개 — 뭘 하는 물건인지, 어디서 받는지.
 *
 * 껍데기(폭·빵부스러기)와 받는 곳 버튼은 /projects/<id> 와 같이 씁니다
 * (ProjectPage · ProjectLinks).
 *
 * 여기 들어가는 문구(summary·features·links)는 전부 consts.ts 에
 * 있습니다. ⚠ 지어내지 말고 저장소 README 나 스토어 설명에서 옮기세요 (§6).
 */
import Icon from '../../../components/Icon.astro'
import ProjectLinks from '../../../components/ProjectLinks.astro'
import ProjectPage from '../../../components/ProjectPage.astro'
import { PROJECTS, type Project } from '../../../consts'
import { countByProject, getPublishedPosts } from '../../../lib/posts'

export async function getStaticPaths() {
  const counts = countByProject(await getPublishedPosts())
  return PROJECTS.map((project) => ({
    params: { project: project.id },
    props: { project, postCount: counts.get(project.id) ?? 0 },
  }))
}

type Props = { project: Project; postCount: number }

const { project, postCount } = Astro.props as Props

const storeName = 'storeName' in project ? project.storeName : null
---

<ProjectPage
  title={`${project.name} — 소개`}
  description={project.summary}
  project={project}
  page="소개"
>
  <header class="head">
    <h1>
      {project.name}
      {project.active && <span class="live">LIVE</span>}
    </h1>
    <p class="tagline">{project.tagline}</p>
    {
      storeName && (
        <p class="storename">App Store 에는 "{storeName}" 로 올라가 있습니다.</p>
      )
    }
    <p class="summary">{project.summary}</p>

    <ProjectLinks project={project} />
  </header>

  <section class="block">
    <h2>이런 걸 할 수 있습니다</h2>
    <ul class="features">
      {project.features.map((feature) => <li>{feature}</li>)}
    </ul>
  </section>

  <section class="block">
    <h2>무엇으로 만들었나</h2>
    <ul class="stack">
      <li class="pill">{project.platform}</li>
      {project.stack.map((tech) => <li class="pill">{tech}</li>)}
    </ul>
  </section>

  <a class="devlog" href={`/projects/${project.id}`}>
    <span>
      {
        postCount > 0
          ? `만들면서 남긴 글 ${postCount}개 보기`
          : '아직 남긴 글은 없습니다'
      }
    </span>
    <Icon name="arrow-right" size={16} />
  </a>
</ProjectPage>

<style>
  .head {
    margin-top: 1.75rem;
    /* 읽는 글이라 폭을 잡아둡니다 — 1280px 를 다 쓰면 한 줄이 너무 깁니다 */
    max-width: 42rem;
  }

  h1 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0.625rem 0 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-dim);
  }

  .storename {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .summary {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--text-dim);
  }

  .block {
    margin-top: 3rem;
    max-width: 42rem;
  }

  .block h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .features {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .features li + li {
    margin-top: 0.625rem;
  }

  .features li::marker {
    color: var(--text-faint);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack .pill {
    font-weight: 700;
    color: var(--text-dim);
  }

  .devlog {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-dim);
    text-decoration: none;
  }

  .devlog:hover {
    color: var(--text);
    background-color: var(--surface);
  }

  @media (min-width: 900px) {
    .head {
      margin-top: 2.25rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
