---
/**
 * 지뢰찾기 아레나 계정 삭제 안내 — Google Play "계정 삭제 URL" 로 쓰는 지면.
 *
 * Play 는 앱을 지운 사람도 삭제를 요청할 수 있는 웹 주소를 요구합니다.
 * 그래서 앱 안 경로와 이메일 요청 두 가지를 다 적습니다.
 *
 * ⚠ 무엇이 지워지는지는 앱 코드(MineAppFlutter lib/core/account_deletion.dart)와
 * 맞아야 합니다. 앱에서 지우는 범위가 바뀌면 여기도 고치세요 — 스토어 심사가 읽는 글입니다.
 * ⚠ 이 주소는 Play Console 에 등록됩니다. 경로를 바꾸면 콘솔도 같이 고쳐야 합니다.
 */
import ProjectPage from '../../../components/ProjectPage.astro'
import { PROJECTS } from '../../../consts'

const project = PROJECTS.find((p) => p.id === 'mineapp')!
const email = 'lim0202jh@gmail.com'
const subject = '[지뢰찾기 아레나] 계정 삭제 요청'
---

<ProjectPage
  title="지뢰찾기 아레나 — 계정 삭제"
  description="지뢰찾기 아레나 계정과 데이터를 삭제하는 방법입니다. 앱에서 바로 지우거나 이메일로 요청할 수 있습니다."
  project={project}
  page="계정 삭제"
>
  <header class="head">
    <h1>지뢰찾기 아레나 계정 삭제</h1>
    <p class="summary">
      지뢰찾기 아레나(MineApp)의 계정과 데이터는 언제든 삭제할 수 있습니다. 앱에서
      바로 지우거나, 앱이 없으면 이메일로 요청해 주세요.
    </p>
  </header>

  <section class="block">
    <h2>앱에서 삭제하기</h2>
    <ol class="steps">
      <li>홈 화면 아래쪽의 "내 정보"를 누릅니다.</li>
      <li>맨 아래 "계정 삭제"를 누르고 확인합니다.</li>
      <li>
        Apple 이나 Google 로 연동한 계정이면 본인 확인 창이 한 번 더 뜹니다. 확인하면
        바로 삭제됩니다.
      </li>
    </ol>
    <p class="note">
      본인 확인을 취소하면 아무것도 지워지지 않습니다. 삭제가 끝나면 앱은 새 계정으로
      처음부터 시작합니다.
    </p>
  </section>

  <section class="block">
    <h2>앱 없이 요청하기</h2>
    <p class="text">
      앱을 이미 지웠다면 아래 주소로 메일을 보내 주세요. 받은 날로부터 7일 안에
      삭제하고 회신드립니다.
    </p>
    <dl class="mail">
      <dt>받는 사람</dt>
      <dd>
        <a href={`mailto:${email}?subject=${encodeURIComponent(subject)}`}>{email}</a>
      </dd>
      <dt>제목</dt>
      <dd>{subject}</dd>
      <dt>적어 주실 것</dt>
      <dd>
        연동한 Apple 또는 Google 계정의 이메일 주소, 그리고 게임 닉네임. 연동하지 않았다면
        닉네임만 적어 주세요 — 랭킹에 남은 기록을 찾아 지웁니다.
      </dd>
    </dl>
  </section>

  <section class="block">
    <h2>지워지는 데이터</h2>
    <ul class="list">
      <li>로그인 계정 (Firebase 인증 정보, 연동한 Apple·Google 계정 연결)</li>
      <li>클라우드 백업 — 코인, 아이템, 난이도별 기록, 칭호, 닉네임</li>
      <li>온라인 랭킹에 올라간 솔로·협동 기록</li>
      <li>기기에 저장된 게임 데이터 (앱에서 삭제한 경우)</li>
    </ul>
  </section>

  <section class="block">
    <h2>남는 데이터와 보관 기간</h2>
    <ul class="list">
      <li>삭제한 데이터는 따로 보관하지 않습니다. 앱에서 지우면 그 자리에서 바로 지워집니다.</li>
      <li>대전 중에 주고받는 정보는 대전이 끝나면 자동으로 지워져 계정과 함께 남지 않습니다.</li>
      <li>
        광고 식별자는 광고를 보여주는 Google AdMob 이 처리하며, 저희 서버에는 저장하지
        않습니다.
      </li>
    </ul>
  </section>

  <section class="block">
    <h2>운영자</h2>
    <p class="text">임재혁 (jeahyuk LIM) · <a href={`mailto:${email}`}>{email}</a></p>
  </section>
</ProjectPage>

<style>
  .head {
    margin-top: 1.75rem;
    /* 소개 페이지(about)와 같은 폭 — 읽는 글이라 한 줄을 잡아둡니다 */
    max-width: 42rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .summary {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--text-dim);
  }

  .block {
    margin-top: 3rem;
    max-width: 42rem;
  }

  .block h2 {
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .steps,
  .list {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-dim);
  }

  .steps li + li,
  .list li + li {
    margin-top: 0.625rem;
  }

  .steps li::marker,
  .list li::marker {
    color: var(--text-faint);
  }

  .text,
  .note {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--text-dim);
  }

  .note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .mail {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.625rem 1.25rem;
    margin: 1.25rem 0 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--card);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .mail dt {
    font-weight: 700;
    color: var(--text);
  }

  .mail dd {
    margin: 0;
    color: var(--text-dim);
    overflow-wrap: anywhere;
  }

  a {
    color: var(--accent-text);
  }

  /* 폰에서는 이름과 값을 위아래로 — 두 칸이면 값 칸이 너무 좁아집니다 */
  @media (max-width: 520px) {
    .mail {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .mail dd + dt {
      margin-top: 0.75rem;
    }
  }

  @media (min-width: 900px) {
    .head {
      margin-top: 2.25rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
