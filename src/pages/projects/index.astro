---
import BaseLayout from '../../components/BaseLayout.astro'
import FeedLayout from '../../components/FeedLayout.astro'
import { PROJECTS } from '../../consts'
import { countByProject, getPublishedPosts } from '../../lib/posts'

const counts = countByProject(await getPublishedPosts())
---

<BaseLayout title="Works" description="만든 것들">
  <FeedLayout>
    <div class="feed-header">
      <span>🎮 Works</span>
      <span class="count">{PROJECTS.length}</span>
    </div>

    {
      PROJECTS.map((project) => (
        <a class="wrap" href={`/projects/${project.id}`}>
          <article class="card">
            <span class="bar" style={`background-color:${project.color}`} />
            <div class="content">
              <div class="top">
                <span
                  class="pill-category"
                  style={`background-color:${project.color}`}
                >
                  {project.name}
                </span>
                {project.active && <span class="live">LIVE</span>}
                <span class="count-right">
                  {counts.get(project.id) ?? 0}개의 글
                </span>
              </div>
              <h2>{project.tagline}</h2>
              <p class="stack">
                {project.platform} · {project.stack.join(', ')}
              </p>
            </div>
          </article>
        </a>
      ))
    }
  </FeedLayout>
</BaseLayout>

<style>
  .feed-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .count {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .card {
    position: relative;
    overflow: hidden;
    margin-bottom: 1rem;
    transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wrap:hover .card {
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
  }

  .content {
    padding: 1.15rem 1.25rem;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .live {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-sm);
    color: var(--card);
    background-color: var(--text-dim);
  }

  .count-right {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  h2 {
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .stack {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }
</style>
