---
import BaseLayout from '../../components/BaseLayout.astro'
import FeedLayout from '../../components/FeedLayout.astro'
import Icon from '../../components/Icon.astro'
import PostCard from '../../components/PostCard.astro'
import { CATEGORIES, categoryTrail, type Category } from '../../consts'
import { getPublishedPosts, postsInCategory, type Post } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return CATEGORIES.map((category) => ({
    params: { path: category.id },
    props: { category, posts: postsInCategory(posts, category.id) },
  }))
}

type Props = { category: Category; posts: Post[] }

const { category, posts } = Astro.props as Props
const trail = categoryTrail(category.id)
---

<BaseLayout
  title={category.label}
  description={`${category.label} 카테고리의 글`}
>
  <FeedLayout currentCategory={category.id}>
    <div class="feed-header">
      <span class="title-ico">
        <Icon name="folder-folders" size={17} />
        {
          trail.map((c, i) => (
            <>
              {i > 0 && <span class="sep">/</span>}
              {i === trail.length - 1 ? (
                <span>{c.label}</span>
              ) : (
                <a href={`/categories/${c.id}`}>{c.label}</a>
              )}
            </>
          ))
        }
      </span>
      <span class="count">{posts.length}</span>
    </div>

    {
      posts.length === 0 ? (
        <p class="empty">아직 이 카테고리의 글이 없습니다.</p>
      ) : (
        posts.map((post) => <PostCard post={post} />)
      )
    }
  </FeedLayout>
</BaseLayout>

<style>
  .feed-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.9375rem;
  }

  .feed-header a {
    color: var(--text-dim);
  }

  .feed-header a:hover {
    color: var(--text);
  }

  .sep {
    color: var(--text-faint);
  }

  .count {
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .empty {
    padding: 1rem 0.25rem;
    color: var(--text-faint);
    font-size: 0.9375rem;
  }
</style>
