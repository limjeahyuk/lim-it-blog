---
/**
 * 서고 — 글 전부를 한 줄씩, 스무 편마다 쪽을 나눠서.
 *
 * 홈의 "더 읽을 글 · 전체보기" 가 오는 곳입니다. 홈·아래 띠와 같은 폭·
 * 같은 여백을 씁니다.
 *
 * ⚠ 여기는 지면이 아니라 서고입니다 — 카드를 두르지 않습니다 (§4).
 *   홈만 카드입니다.
 *
 * ⚠ **2026-09-08 시안에서 셋이 없어졌습니다** — 왼쪽 세로 에디터 줄,
 *   연도 묶음(`2026` 같은 소제목), 그리고 줄마다 붙던 썸네일. 대신 위에
 *   알약 줄이 서고 아래에 쪽 단추가 생겼습니다.
 *   · 에디터는 이제 **거르는 것이 아니라 넘어가는 것**입니다 (EditorTabs).
 *   · 연도는 날짜(`09.08`)에서만 빠진 것이 아니라 묶음 자체가 없습니다.
 *     쪽이 나뉘면 한 쪽에 한두 해만 들어가서, 소제목이 쪽마다 하나씩
 *     떠 있는 꼴이 됩니다.
 *   · 썸네일은 131줄에 사진을 다 까는 자리라 원래도 640px 아래에서는
 *     빼고 있었습니다.
 */
import BaseLayout from '../../components/BaseLayout.astro'
import EditorTabs from '../../components/EditorTabs.astro'
import FormattedDate from '../../components/FormattedDate.astro'
import Icon from '../../components/Icon.astro'
import { getAuthor } from '../../consts'
import { getPublishedPosts } from '../../lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout title="Posts" description="전체 글 목록">
  <div class="wrap">
    <EditorTabs current="" />

    <header class="head">
      <h1>전체 글</h1>
      <span class="total">총 <b>{posts.length}</b>개</span>
    </header>

    <div class="rows">
      {
        posts.map((post) => (
          <a class="row" href={`/posts/${post.id}/`}>
            <span class="title">
              {post.data.secret && (
                <span class="lock" title="비밀글">
                  <Icon name="lock" size={13} />
                </span>
              )}
              {post.data.title}
            </span>

            {post.data.author && (
              <span class="who" style={`color:${getAuthor(post.data.author)?.color}`}>
                {getAuthor(post.data.author)?.name}
              </span>
            )}

            <span class="date">
              <FormattedDate date={post.data.pubDate} short />
            </span>
          </a>
        ))
      }
    </div>

    <nav class="pager" data-pager aria-label="쪽"></nav>
  </div>
</BaseLayout>

<script>
  import { setupPager } from '../../lib/pager'

  /*
    옛 `?author=` 주소를 저자 지면으로 넘깁니다. 거르기가 없어졌는데
    (EditorTabs 의 설명) 그 주소로 들어오면 아무 일도 안 일어난 채
    전체 목록만 보이거든요. 주소만 바꾸는 것이라 replace 입니다 —
    뒤로가기를 눌렀을 때 다시 여기로 튕기면 안 됩니다.
  */
  const author = new URL(location.href).searchParams.get('author')
  if (author && /^[a-z0-9-]+$/.test(author)) {
    location.replace(`/authors/${author}`)
  } else {
    setupPager({
      rows: [...document.querySelectorAll<HTMLElement>('.rows .row')],
      mount: document.querySelector<HTMLElement>('[data-pager]')!,
      top: document.querySelector<HTMLElement>('.head'),
    })
  }
</script>

<style>
  /* 홈·아래 띠와 같은 폭·같은 여백입니다. 어긋나면 양끝이 안 맞습니다. */
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin: 2rem 0 0.5rem;
    /* 쪽을 옮길 때 여기가 화면 위로 옵니다 — 머리띠에 가리지 않게 */
    scroll-margin-top: 4rem;
  }

  .head h1 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .total {
    font-size: 0.8125rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .total b {
    font-weight: 700;
    color: var(--text-dim);
  }

  /* ── 한 줄 ────────────────────────────────────────────── */

  .row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1.0625rem 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .row[hidden] {
    display: none;
  }

  .title {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .row:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lock {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--text-faint);
  }

  .who {
    flex-shrink: 0;
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .date {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 저자 이름은 좁은 화면에서 빼고 날짜만 남깁니다. */
  @media (max-width: 640px) {
    .who {
      display: none;
    }

    .date {
      margin-left: auto;
    }
  }

  @media (min-width: 900px) {
    .wrap {
      padding: 2.5rem 2rem 0;
    }

    .head h1 {
      font-size: 2.25rem;
    }

    .title {
      font-size: 1rem;
    }

    /* 저자 이름과 날짜가 줄마다 같은 자리에 서게 폭을 못박습니다 */
    .who {
      width: 7rem;
      text-align: right;
    }

    .date {
      width: 3rem;
      text-align: right;
    }
  }
</style>
