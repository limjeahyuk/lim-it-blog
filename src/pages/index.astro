---
/**
 * 홈 — 뉴스 지면.
 *
 *   1. 헤드라인 한 편 크게 + 옆에 세 줄
 *   2. 인기 글 — 카드 넷. 조회수 순 (못 받아오면 「최신 글」 최신순 그대로)
 *   3. 더 읽을 글 — 번호 여덟 줄 + 전체보기
 *
 * ⚠ 2026-09-08 시안에서 **두 덩어리의 이름이 맞바뀌었습니다.** 전에는 카드가
 *   「최신 글」이고 번호 줄이 조회수 순이었는데, 카드는 헤드라인·옆줄이 최신
 *   넷을 먼저 집어간 **다섯째 글부터**라 「최신 글」이라는 이름이 거짓말이었습니다.
 *   지금은 카드가 조회수 순이고 번호 줄이 최신순입니다.
 *
 * ⚠ 홈에만 상자(카드)를 씁니다. `/posts` 같은 목록은 여전히 "카드가 아니라
 *   줄"입니다 — 왜 갈라놨는지는 CLAUDE.md §4 에 있습니다.
 *
 * ⚠ 저자 묶음이 없습니다. 최신순으로만 잘라 쓰기 때문에 새 글이 한 저자에게
 *   몰리면 위쪽이 그 저자로 다 찹니다. 알고 고른 것입니다 (§8).
 */
import BaseLayout from '../components/BaseLayout.astro'
import Cover from '../components/Cover.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { SITE_DESCRIPTION, SITE_TITLE, getAuthor } from '../consts'
import { coverOf } from '../lib/cover'
import { getPublishedPosts } from '../lib/posts'

const posts = await getPublishedPosts()

/*
  위에서부터 최신순으로 잘라 씁니다. 겹치지 않게 이어서 집어가기 때문에
  한 덩어리를 늘리면 아래가 그만큼 밀립니다.
*/
const lead = posts[0]
const side = posts.slice(1, 4)
const latest = posts.slice(4, 8)
const more = posts.slice(8, 16)

const who = (id?: string) => (id ? getAuthor(id) : undefined)
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="wrap">
    {/* ── 헤드라인 ───────────────────────────────── */}
    <section class="top">
      <a class="hero" href={`/posts/${lead.id}/`}>
        <Cover
          cover={coverOf(lead)}
          alt=""
          ratio="16 / 10"
          sizes="(min-width: 900px) 62vw, 100vw"
          tint={who(lead.data.author)?.color}
        />
        <div class="hero-text">
          <span class="kicker">
            {
              who(lead.data.author) && (
                <span style={`color:${who(lead.data.author)!.color}`}>
                  {who(lead.data.author)!.name}
                </span>
              )
            }
            <span class="dot">·</span>새 글
          </span>
          <h1>{lead.data.title}</h1>
        </div>
      </a>

      <div class="side">
        {
          side.map((post) => (
            <a class="side-item" href={`/posts/${post.id}/`}>
              <div class="thumb">
                <Cover
                  cover={coverOf(post)}
                  alt=""
                  ratio="1 / 1"
                  sizes="96px"
                  tint={who(post.data.author)?.color}
                />
              </div>
              <div class="side-text">
                {who(post.data.author) && (
                  <span class="who" style={`color:${who(post.data.author)!.color}`}>
                    {who(post.data.author)!.name}
                  </span>
                )}
                <h3>{post.data.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* ── 인기 글 ────────────────────────────────────
        서버는 최신순으로 그려 두고, 브라우저가 조회수를 받아 오면 그때
        순서·제목·사진을 인기순으로 갈아 끼웁니다 (맨 아래 script · §6-6).

        ⚠ **못 받아오면 제목이 「최신 글」로 남습니다.** 세지도 않은 것에
          「인기 글」이라고 써 붙이면 센 척하는 것이 됩니다. */}
    <section class="sec">
      <header class="sec-head">
        <h2 id="cards-head">최신 글</h2>
      </header>

      <div class="cards">
        {
          latest.map((post) => (
            <a class="card" href={`/posts/${post.id}/`}>
              <Cover
                cover={coverOf(post)}
                alt=""
                ratio="16 / 10"
                sizes="(min-width: 900px) 25vw, 50vw"
                tint={who(post.data.author)?.color}
              />
              <div class="card-body">
                {who(post.data.author) && (
                  <span class="who" style={`color:${who(post.data.author)!.color}`}>
                    {who(post.data.author)!.name}
                  </span>
                )}
                <h3>{post.data.title}</h3>
                <span class="date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* ── 더 읽을 글 ─────────────────────────────────
        언제나 최신순입니다. 위 덩어리가 인기순으로 갈릴 때 **거기 올라간
        글은 여기서 빠집니다** — 같은 화면에 두 번 나오지 않게. */}
    <section class="sec">
      <header class="sec-head">
        <h2>더 읽을 글</h2>
        <a class="more" href="/posts">전체보기 →</a>
      </header>

      <ol class="ranks">
        {
          more.map((post, i) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{post.data.title}</h3>
                <span class="date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  /* 아래 띠(SiteFooter)와 같은 폭·같은 여백입니다. 둘이 어긋나면 양끝이 안 맞습니다. */
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
  }

  /* ── 헤드라인 ─────────────────────────────────────────── */

  .top {
    display: grid;
    gap: 1rem;
  }

  .hero {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  /*
    사진 위에 글자를 얹기 때문에 아래를 어둡게 깔아야 합니다.

    ⚠ 옅게 깔면 안 됩니다. 커버가 밝은 앱 캡처거나 GridBrawl 게임 화면처럼
      잔글씨가 빽빽한 캡처일 때, 제목이 배경과 섞여서 안 읽힙니다.
      한 번 얕게 깔았다가 그것 때문에 다시 진하게 만든 값입니다.
  */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.94) 0%,
      rgb(0 0 0 / 0.78) 22%,
      rgb(0 0 0 / 0.42) 48%,
      rgb(0 0 0 / 0.12) 72%,
      transparent 100%
    );
  }

  .hero-text {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 1.25rem;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.72);
  }

  .kicker .dot {
    color: rgb(255 255 255 / 0.4);
  }

  .hero h1 {
    margin: 0.5rem 0 0;
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.02em;
    /* 사진 위라 테마와 상관없이 흰 글자입니다 */
    color: #fff;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .side-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.875rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--card);
    color: inherit;
    text-decoration: none;
  }

  .side-item .thumb :global(.frame) {
    border-radius: var(--radius-sm);
  }

  .side-text h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .side-item:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .who {
    font-size: 0.6875rem;
    font-weight: 700;
  }

  /* ── 섹션 머리 ────────────────────────────────────────── */

  .sec {
    margin-top: 2.5rem;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .sec-head h2 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .more {
    font-size: 0.8125rem;
    color: var(--accent-text);
    text-decoration: none;
  }

  /* ── 최신 글 카드 ─────────────────────────────────────── */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--card);
    color: inherit;
    text-decoration: none;
  }

  .card-body {
    padding: 0.75rem 0.875rem 0.875rem;
  }

  .card h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.25rem 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  /* ── 더 읽을 글 ───────────────────────────────────────── */

  .ranks {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .ranks li {
    border-bottom: 1px solid var(--border);
  }

  .ranks a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.875rem 0;
    color: inherit;
    text-decoration: none;
  }

  /*
    번호는 순위가 아니라 목록 번호입니다 — 이 덩어리는 언제나 최신순입니다.
    순위는 위쪽 「인기 글」 카드가 맡습니다 (§6-6).
  */
  .num {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--accent-text);
  }

  .ranks h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .ranks a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── 큰 화면 ──────────────────────────────────────────── */

  @media (min-width: 900px) {
    .wrap {
      padding: 2rem 2rem 0;
    }

    .top {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      gap: 1.25rem;
      /* 옆줄 셋의 높이 합이 헤드라인과 같아지게 늘립니다 */
      align-items: stretch;
    }

    .side {
      justify-content: space-between;
    }

    .side-item {
      flex: 1;
    }

    .hero-text {
      padding: 2rem;
    }

    .hero h1 {
      font-size: 2rem;
      max-width: 22ch;
    }

    .kicker {
      font-size: 0.8125rem;
    }

    .sec {
      margin-top: 3.5rem;
    }

    .sec-head h2 {
      font-size: 1.25rem;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }

    .ranks a {
      grid-template-columns: 3rem 1fr auto;
      padding: 1.125rem 0;
    }

    .num {
      font-size: 1.0625rem;
    }

    .ranks h3 {
      font-size: 1rem;
    }
  }
</style>

<script>
  /*
    「최신 글」 카드 넷을 **조회수 순**으로 갈아 끼웁니다 (§6-6).

    홈은 빌드할 때 굳는 지면이라 순위를 미리 넣을 수가 없습니다. 그래서
    최신순으로 그려 두고, 브라우저가 두 가지를 받아 옵니다 — `/api/views`
    에서 **순서만**(숫자는 안 옵니다), `/ranks.json` 에서 주소·제목·날짜·
    커버 사진·저자.

    ⚠ **못 받아오면 아무것도 안 합니다.** 제목이 「최신 글」로 남고 카드도
      최신순 그대로입니다. 스크립트가 죽었을 때 지면이 빈 채로 남지 않게
      하는 것(§4)과 같은 규칙이고, 여기서는 **거짓말을 안 하는 쪽**이기도
      합니다 — 세지도 않은 것에 「인기 글」이라고 써 붙일 수는 없습니다.

    ⚠ **헤드라인·옆줄에 이미 나온 넷은 뺍니다.** 바로 위에 있는 글이 그
      아래 인기 글에 또 나오면 같은 화면에 두 번입니다. 어느 글이 나와
      있는지는 DOM 에서 읽습니다 — 그려 놓은 것이 곧 정답이라 목록을 따로
      심어 둘 필요가 없습니다.

    ⚠ **「더 읽을 글」도 같이 다시 그립니다.** 카드가 인기순으로 갈리면
      원래 카드에 있던 글이 아래 번호 줄과 겹칠 수 있습니다. 그래서 위에
      쓴 것을 전부 빼고 최신순으로 여덟 줄을 다시 채웁니다.

    ⚠ **모자라면 최신순으로 채웁니다.** 조회수가 잡힌 글이 몇 편뿐인 동안
      카드가 한 장만 남으면 지면에 구멍이 납니다.
  */
  type Row = { s: string; t: string; d: string; c: string; n: string; k: string }

  const head = document.querySelector<HTMLElement>('#cards-head')
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.cards .card')]
  const rankItems = [...document.querySelectorAll<HTMLElement>('.ranks li')]

  const slugOf = (href: string | null) => {
    const m = /^\/posts\/([^/]+)\//.exec(href || '')
    return m ? m[1] : ''
  }

  const fmt = (d: string) =>
    new Date(d + 'T00:00:00').toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })

  /*
    커버는 Cover.astro 가 그린 `.frame` 을 그대로 씁니다. 사진이 없는 글은
    `.blank`(저자 색 판)이라, 사진이 있는 글로 갈아 끼울 때 그 클래스를 떼고
    <img> 를 넣어야 합니다. 반대도 마찬가지입니다.

    ⚠ `style.color` 만 건드립니다 — 같은 인라인 style 에 aspect-ratio 가
      들어 있어서 통째로 덮으면 칸 비율이 무너집니다.
  */
  function paintCover(frame: HTMLElement, row: Row) {
    let img = frame.querySelector('img')

    if (row.c) {
      frame.classList.remove('blank')
      frame.style.color = ''
      if (!img) {
        img = document.createElement('img')
        img.alt = ''
        img.loading = 'lazy'
        img.decoding = 'async'
        frame.appendChild(img)
      }
      if (img.getAttribute('src') !== row.c) img.setAttribute('src', row.c)
      return
    }

    frame.classList.add('blank')
    frame.style.color = row.k || ''
    if (img) img.remove()
  }

  function paintCard(card: HTMLAnchorElement, row: Row) {
    card.setAttribute('href', `/posts/${row.s}/`)

    const frame = card.querySelector<HTMLElement>('.frame')
    if (frame) paintCover(frame, row)

    const who = card.querySelector<HTMLElement>('.who')
    if (who) {
      who.textContent = row.n
      who.style.color = row.k
      who.hidden = !row.n
    }

    const title = card.querySelector('h3')
    if (title) title.textContent = row.t

    const time = card.querySelector('time')
    if (time) {
      time.setAttribute('datetime', row.d)
      time.textContent = fmt(row.d)
    }
  }

  function paintRank(li: HTMLElement, row: Row, i: number) {
    const a = li.querySelector('a')
    const num = li.querySelector<HTMLElement>('.num')
    const title = li.querySelector('h3')
    const time = li.querySelector('time')
    if (!a || !title || !time) return

    a.setAttribute('href', `/posts/${row.s}/`)
    if (num) num.textContent = String(i + 1).padStart(2, '0')
    title.textContent = row.t
    time.setAttribute('datetime', row.d)
    time.textContent = fmt(row.d)
  }

  async function popular() {
    if (!head || !cards.length) return

    const [ranked, rows] = await Promise.all([
      fetch('/api/views')
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null),
      fetch('/ranks.json')
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null),
    ])

    const order: string[] = (ranked && ranked.order) || []
    if (!order.length || !Array.isArray(rows) || !rows.length) return

    /* rows 는 최신순입니다 — 뒤에서 「더 읽을 글」을 채울 때 그대로 씁니다. */
    const latest = rows as Row[]
    const by = new Map<string, Row>()
    for (const row of latest) by.set(row.s, row)

    /* 헤드라인·옆줄에 이미 나와 있는 글 */
    const used = new Set<string>()
    for (const a of document.querySelectorAll<HTMLAnchorElement>(
      '.hero, .side-item',
    )) {
      const s = slugOf(a.getAttribute('href'))
      if (s) used.add(s)
    }

    const top: string[] = []
    for (const s of order) {
      if (top.length >= cards.length) break
      if (used.has(s) || !by.has(s)) continue
      top.push(s)
      used.add(s)
    }

    /* 조회수로 채운 것이 하나도 없으면 「최신 글」 그대로 둡니다 */
    if (!top.length) return

    for (const row of latest) {
      if (top.length >= cards.length) break
      if (used.has(row.s)) continue
      top.push(row.s)
      used.add(row.s)
    }

    cards.forEach((card, i) => {
      const row = by.get(top[i])
      if (row) paintCard(card, row)
      else card.hidden = true
    })

    head.textContent = '인기 글'

    /* 위에 올라간 글을 뺀 나머지를 최신순으로 */
    const rest = latest.filter((row) => !used.has(row.s))
    rankItems.forEach((li, i) => {
      const row = rest[i]
      if (row) paintRank(li, row, i)
      else li.remove()
    })
  }

  popular().catch(() => {})
</script>
