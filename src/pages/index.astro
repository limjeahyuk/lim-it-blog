---
/**
 * 홈 — 뉴스 지면.
 *
 *   1. 헤드라인 한 편 크게 + 옆에 세 줄
 *   2. 최신 글 카드 넷
 *   3. 더 읽을 글 (번호 붙은 줄)
 *   4. Editors · Service · Contact
 *
 * ⚠ 홈에만 상자(카드)를 씁니다. `/posts` 같은 목록은 여전히 "카드가 아니라
 *   줄"입니다 — 왜 갈라놨는지는 CLAUDE.md §4 에 있습니다.
 *
 * ⚠ 저자 묶음이 없습니다. 최신순으로만 잘라 쓰기 때문에 새 글이 한 저자에게
 *   몰리면 위쪽이 그 저자로 다 찹니다. 알고 고른 것입니다 (§8).
 */
import BaseLayout from '../components/BaseLayout.astro'
import Cover from '../components/Cover.astro'
import FormattedDate from '../components/FormattedDate.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { SITE_DESCRIPTION, SITE_TITLE, getAuthor } from '../consts'
import { coverOf } from '../lib/cover'
import { getPublishedPosts } from '../lib/posts'

const posts = await getPublishedPosts()

/*
  위에서부터 최신순으로 잘라 씁니다. 겹치지 않게 이어서 집어가기 때문에
  한 덩어리를 늘리면 아래가 그만큼 밀립니다.
*/
const lead = posts[0]
const side = posts.slice(1, 4)
const latest = posts.slice(4, 8)
const more = posts.slice(8, 16)

const who = (id?: string) => (id ? getAuthor(id) : undefined)
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="wrap">
    {/* ── 헤드라인 ───────────────────────────────── */}
    <section class="top">
      <a class="hero" href={`/posts/${lead.id}/`}>
        <Cover
          cover={coverOf(lead)}
          alt=""
          ratio="16 / 10"
          sizes="(min-width: 900px) 62vw, 100vw"
          tint={who(lead.data.author)?.color}
        />
        <div class="hero-text">
          <span class="kicker">
            {
              who(lead.data.author) && (
                <span style={`color:${who(lead.data.author)!.color}`}>
                  {who(lead.data.author)!.name}
                </span>
              )
            }
            <span class="dot">·</span>새 글
          </span>
          <h1>{lead.data.title}</h1>
        </div>
      </a>

      <div class="side">
        {
          side.map((post) => (
            <a class="side-item" href={`/posts/${post.id}/`}>
              <div class="thumb">
                <Cover
                  cover={coverOf(post)}
                  alt=""
                  ratio="1 / 1"
                  sizes="96px"
                  tint={who(post.data.author)?.color}
                />
              </div>
              <div class="side-text">
                {who(post.data.author) && (
                  <span class="who" style={`color:${who(post.data.author)!.color}`}>
                    {who(post.data.author)!.name}
                  </span>
                )}
                <h3>{post.data.title}</h3>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* ── 최신 글 ────────────────────────────────── */}
    <section class="sec">
      <header class="sec-head">
        <h2>최신 글</h2>
        <a class="more" href="/posts">전체보기 →</a>
      </header>

      <div class="cards">
        {
          latest.map((post) => (
            <a class="card" href={`/posts/${post.id}/`}>
              <Cover
                cover={coverOf(post)}
                alt=""
                ratio="16 / 10"
                sizes="(min-width: 900px) 25vw, 50vw"
                tint={who(post.data.author)?.color}
              />
              <div class="card-body">
                {who(post.data.author) && (
                  <span class="who" style={`color:${who(post.data.author)!.color}`}>
                    {who(post.data.author)!.name}
                  </span>
                )}
                <h3>{post.data.title}</h3>
                <span class="date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    {/* ── 더 읽을 글 ─────────────────────────────── */}
    <section class="sec">
      <header class="sec-head">
        <h2>더 읽을 글</h2>
      </header>

      <ol class="ranks">
        {
          more.map((post, i) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{post.data.title}</h3>
                <span class="date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  /* 아래 띠(SiteFooter)와 같은 폭·같은 여백입니다. 둘이 어긋나면 양끝이 안 맞습니다. */
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 0;
  }

  /* ── 헤드라인 ─────────────────────────────────────────── */

  .top {
    display: grid;
    gap: 1rem;
  }

  .hero {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  /*
    사진 위에 글자를 얹기 때문에 아래를 어둡게 깔아야 합니다.

    ⚠ 옅게 깔면 안 됩니다. 커버가 밝은 앱 캡처거나 GridBrawl 게임 화면처럼
      잔글씨가 빽빽한 캡처일 때, 제목이 배경과 섞여서 안 읽힙니다.
      한 번 얕게 깔았다가 그것 때문에 다시 진하게 만든 값입니다.
  */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.94) 0%,
      rgb(0 0 0 / 0.78) 22%,
      rgb(0 0 0 / 0.42) 48%,
      rgb(0 0 0 / 0.12) 72%,
      transparent 100%
    );
  }

  .hero-text {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 1.25rem;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.72);
  }

  .kicker .dot {
    color: rgb(255 255 255 / 0.4);
  }

  .hero h1 {
    margin: 0.5rem 0 0;
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.02em;
    /* 사진 위라 테마와 상관없이 흰 글자입니다 */
    color: #fff;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .side-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.875rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--card);
    color: inherit;
    text-decoration: none;
  }

  .side-item .thumb :global(.frame) {
    border-radius: var(--radius-sm);
  }

  .side-text h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .side-item:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .who {
    font-size: 0.6875rem;
    font-weight: 700;
  }

  /* ── 섹션 머리 ────────────────────────────────────────── */

  .sec {
    margin-top: 2.5rem;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .sec-head h2 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .more {
    font-size: 0.8125rem;
    color: var(--accent-text);
    text-decoration: none;
  }

  /* ── 최신 글 카드 ─────────────────────────────────────── */

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--card);
    color: inherit;
    text-decoration: none;
  }

  .card-body {
    padding: 0.75rem 0.875rem 0.875rem;
  }

  .card h3 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0.25rem 0 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  /* ── 더 읽을 글 ───────────────────────────────────────── */

  .ranks {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .ranks li {
    border-bottom: 1px solid var(--border);
  }

  .ranks a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.875rem 0;
    color: inherit;
    text-decoration: none;
  }

  /*
    번호는 순위가 아니라 목록 번호입니다 — 조회수 같은 건 정적 사이트라
    셀 방법이 없어서, 오른쪽은 날짜로 뒀습니다.
  */
  .num {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--accent-text);
  }

  .ranks h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .ranks a:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── 큰 화면 ──────────────────────────────────────────── */

  @media (min-width: 900px) {
    .wrap {
      padding: 2rem 2rem 0;
    }

    .top {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      gap: 1.25rem;
      /* 옆줄 셋의 높이 합이 헤드라인과 같아지게 늘립니다 */
      align-items: stretch;
    }

    .side {
      justify-content: space-between;
    }

    .side-item {
      flex: 1;
    }

    .hero-text {
      padding: 2rem;
    }

    .hero h1 {
      font-size: 2rem;
      max-width: 22ch;
    }

    .kicker {
      font-size: 0.8125rem;
    }

    .sec {
      margin-top: 3.5rem;
    }

    .sec-head h2 {
      font-size: 1.25rem;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }

    .ranks a {
      grid-template-columns: 3rem 1fr auto;
      padding: 1.125rem 0;
    }

    .num {
      font-size: 1.0625rem;
    }

    .ranks h3 {
      font-size: 1rem;
    }
  }
</style>
