---
import BaseLayout from '../components/BaseLayout.astro'
import FeedLayout from '../components/FeedLayout.astro'
import Icon from '../components/Icon.astro'
import PostCard from '../components/PostCard.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'
import { getPublishedPosts } from '../lib/posts'

const posts = await getPublishedPosts()

/** 첫 화면은 최근 것만 보여줍니다. 100개가 넘어가면 전부 그리는 게 의미가 없습니다. */
const RECENT = 20
const recent = posts.slice(0, RECENT)
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <FeedLayout>
    <header class="masthead">
      <p class="kicker">Latest</p>
      <p class="tagline">{SITE_DESCRIPTION}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">아직 글이 없습니다.</p>
      ) : (
        recent.map((post, i) => <PostCard post={post} lead={i === 0} />)
      )
    }

    {
      posts.length > RECENT && (
        <a class="more" href="/posts">
          <span>글 {posts.length}편 전부 보기</span>
          <Icon name="chevron-right" size={16} />
        </a>
      )
    }
  </FeedLayout>
</BaseLayout>

<style>
  .masthead {
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    margin: 0 0 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .tagline {
    margin: 0;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-dim);
  }

  .empty {
    padding: 1rem 0.25rem;
    color: var(--text-faint);
    font-size: 0.9375rem;
  }

  .more {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem 0.25rem;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    color: var(--text-dim);
  }

  .more:hover {
    color: var(--text);
  }

  .more span {
    margin-right: auto;
  }
</style>
