---
/**
 * 저자 목록. the-edit 의 /editors 자리입니다.
 *
 * 글이 0개인 저자도 여기에는 나옵니다 — 사이드바와 다른 규칙입니다.
 * 사이드바는 고르는 곳이라 빈 이름이 방해가 되지만, 이 페이지는 소개하는
 * 곳이라 아직 안 쓴 이름이 있는 게 이상하지 않습니다.
 */
import Avatar from '../../components/Avatar.astro'
import BaseLayout from '../../components/BaseLayout.astro'
import FeedLayout from '../../components/FeedLayout.astro'
import { AUTHORS } from '../../consts'
import { countByAuthor, getPublishedPosts } from '../../lib/posts'

const counts = countByAuthor(await getPublishedPosts())
---

<BaseLayout title="Editors" description={AUTHORS.map((a) => a.name).join(' · ')}>
  <FeedLayout>
    <h1>Editors</h1>

    <div class="grid">
      {
        AUTHORS.map((a) => (
          <a class="who" href={`/authors/${a.id}`}>
            <Avatar
              name={a.name}
              initial={a.initial}
              color={a.color}
              src={a.avatar}
            />
            <div class="name" style={`color:${a.color}`}>
              {a.name}
            </div>
            <p class="bio">{a.bio}</p>
            <p class="count">글 {counts.get(a.id) ?? 0}편</p>
          </a>
        ))
      }
    </div>
  </FeedLayout>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2.5rem;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--accent-text);
  }

  /*
    칸을 고정 폭으로 채웁니다. 저자가 둘일 때는 왼쪽부터 두 칸만 차고,
    늘어나면 다음 줄로 넘어갑니다 — 레퍼런스(the-edit)도 마지막 줄이
    왼쪽 정렬로 남습니다.
  */
  .grid {
    display: grid;
    /* 140px 이면 375px 폰에서 두 칸이 들어갑니다. 160px 이면 한 칸이 되고,
       저자 하나가 화면을 통째로 먹어서 스크롤이 길어집니다. */
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .who {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .who:hover .name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .bio {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .count {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
</style>
