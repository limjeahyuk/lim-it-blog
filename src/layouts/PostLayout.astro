---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../components/BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { SITE_DESCRIPTION, getAuthor, getProject } from '../consts'

/**
 * `excerpt` 는 본문에서 뽑은 요약입니다. `<head>` 의 meta description 에만
 * 쓰고 화면에는 안 띄웁니다 — 소개문이 없는 글은 없는 채로 둡니다.
 */
type Props = CollectionEntry<'posts'>['data'] & { excerpt?: string }

const {
  title,
  description,
  excerpt,
  pubDate,
  updatedDate,
  heroImage,
  author,
  project,
} = Astro.props

const proj = project ? getProject(project) : undefined
const who = author ? getAuthor(author) : undefined
---

<BaseLayout
  title={title}
  description={description || excerpt || SITE_DESCRIPTION}
  image={heroImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={who?.name}
>
  <div class="shell">
    <article class="card">
      {
        /* public/ 의 원본이 그대로 나갑니다 — heroImage 는 Astro 자산이
           아니라 공개 경로라 <Image> 로 못 뽑습니다 (content.config.ts) */
        heroImage && <img class="hero" src={heroImage} alt="" />
      }

      <div class="body">
        <header class="head">
          {
            proj && (
              <a
                class="pill-category"
                style={`background-color:${proj.color}`}
                href={`/projects/${proj.id}`}
              >
                {proj.name}
              </a>
            )
          }
          <h1>{title}</h1>
          {description && <p class="desc">{description}</p>}
          <div class="meta">
            {
              who && (
                <>
                  <a class="who" href={`/authors/${who.id}`} style={`color:${who.color}`}>
                    {who.name}
                  </a>
                  <span class="sep">·</span>
                </>
              )
            }
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <>
                  <span class="sep">·</span>
                  <span>
                    수정 <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>
        </header>

        <hr />

        <div class="prose">
          <slot />
        </div>
      </div>
    </article>

    <a class="back" href="/">← 목록으로</a>
  </div>
</BaseLayout>

<style>
  .shell {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  @media (max-width: 768px) {
    .shell {
      padding: 0.5rem 1rem 3rem;
    }
  }

  .card {
    overflow: hidden;
    display: block;
  }

  .hero {
    width: 100%;
    height: auto;
    display: block;
  }

  .body {
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .body {
      padding: 1.25rem;
    }
  }

  .head .pill-category {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.45rem;
    }
  }

  .desc {
    margin: 0 0 1rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .sep {
    opacity: 0.6;
  }

  /* 저자 이름이 이 줄에서 유일하게 색이 들어가는 자리입니다. */
  .who {
    font-weight: 600;
  }

  .who:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  hr {
    margin: 1.75rem 0;
  }

  .back {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .back:hover {
    color: var(--text);
  }
</style>

<script>
  /*
    코드 블록의 「복사」.

    ⚠ 단추 하나하나에 거는 게 아니라 **문서에 한 번** 겁니다. 비밀글은
      본문이 나중에 풀려서 그때 DOM 에 들어오는데(SecretGate), 그렇게 들어온
      코드 블록도 그대로 눌립니다.
    ⚠ `navigator.clipboard` 는 보안 컨텍스트(https·localhost)에만 있습니다.
      없으면 단추를 아예 안 보이게 둡니다 — 눌리지도 않는 단추가 코드마다
      붙어 있는 것보다 낫습니다 (`html.has-copy` 로 켭니다).
  */
  if (navigator.clipboard) {
    document.documentElement.classList.add('has-copy')

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null
      const btn = target && target.closest ? target.closest('.code-copy') : null
      if (!btn) return

      const fig = btn.closest('figure.code')
      const pre = fig ? fig.querySelector('pre') : null
      if (!pre) return

      try {
        await navigator.clipboard.writeText(pre.innerText)
        btn.textContent = '복사됨'
      } catch {
        btn.textContent = '실패'
      }
      setTimeout(() => {
        btn.textContent = '복사'
      }, 1200)
    })
  }
</script>

<script>
  /*
    조회수 세기.

    글 하나를 열면 `/api/views` 에 한 번 알립니다. **숫자는 안 받아옵니다** —
    조회수는 읽는 사람한테 안 보이기로 했습니다 (§6-6). 이 요청이 하는 일은
    Redis 해시를 하나 올리는 것뿐이고, 실패하면 조용히 넘어갑니다.

    ⚠ **주소에서 slug 를 뽑습니다.** 글 주소가 `/posts/<slug>/` 라 그대로
      쓰면 되고, 그래야 이 파일을 쓰는 쪽에 prop 을 하나 더 안 붙입니다.

    ⚠ **같은 기기는 하루에 한 번만 셉니다.** 오탈자를 고치느라 같은 글을
      열 번 열어도 열 번 세면 제 손이 순위를 만듭니다. 그렇다고 정확한
      숫자가 되는 것은 아닙니다 — 광고 차단기와 봇은 못 거릅니다.

    ⚠ **로컬에서는 안 셉니다.** 개발하면서 새로고침한 것이 순위에 섞입니다.
  */
  const ONE_DAY = 24 * 60 * 60 * 1000

  const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
  const slug = location.pathname.replace(/^\/posts\//, '').replace(/\/+$/, '')

  if (!local && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) {
    const key = 'lim.view.' + slug
    let fresh = true
    try {
      const last = Number(localStorage.getItem(key) || 0)
      fresh = !last || Date.now() - last > ONE_DAY
    } catch {
      /* 사생활 보호 창에서는 localStorage 가 던집니다 — 그냥 셉니다 */
    }

    if (fresh) {
      try {
        localStorage.setItem(key, String(Date.now()))
      } catch {}

      fetch('/api/views', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
        keepalive: true,
      }).catch(() => {})
    }
  }
</script>
