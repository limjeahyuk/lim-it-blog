---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../components/BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { SITE_DESCRIPTION, getAuthor, getProject } from '../consts'

/**
 * `excerpt` 는 본문에서 뽑은 요약입니다. `<head>` 의 meta description 에만
 * 쓰고 화면에는 안 띄웁니다 — 소개문이 없는 글은 없는 채로 둡니다.
 */
type Props = CollectionEntry<'posts'>['data'] & { excerpt?: string }

const {
  title,
  description,
  excerpt,
  pubDate,
  updatedDate,
  heroImage,
  author,
  project,
} = Astro.props

const proj = project ? getProject(project) : undefined
const who = author ? getAuthor(author) : undefined
---

<BaseLayout
  title={title}
  description={description || excerpt || SITE_DESCRIPTION}
  image={heroImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={who?.name}
>
  <div class="shell">
    <article class="card">
      {
        /* public/ 의 원본이 그대로 나갑니다 — heroImage 는 Astro 자산이
           아니라 공개 경로라 <Image> 로 못 뽑습니다 (content.config.ts) */
        heroImage && <img class="hero" src={heroImage} alt="" />
      }

      <div class="body">
        <header class="head">
          {
            proj && (
              <a
                class="pill-category"
                style={`background-color:${proj.color}`}
                href={`/projects/${proj.id}`}
              >
                {proj.name}
              </a>
            )
          }
          <h1>{title}</h1>
          {description && <p class="desc">{description}</p>}
          <div class="meta">
            {
              who && (
                <>
                  <a class="who" href={`/authors/${who.id}`} style={`color:${who.color}`}>
                    {who.name}
                  </a>
                  <span class="sep">·</span>
                </>
              )
            }
            <FormattedDate date={pubDate} />
            {
              updatedDate && (
                <>
                  <span class="sep">·</span>
                  <span>
                    수정 <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>
        </header>

        <hr />

        <div class="prose">
          <slot />
        </div>
      </div>
    </article>

    <a class="back" href="/">← 목록으로</a>
  </div>
</BaseLayout>

<style>
  .shell {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  @media (max-width: 768px) {
    .shell {
      padding: 0.5rem 1rem 3rem;
    }
  }

  .card {
    overflow: hidden;
    display: block;
  }

  .hero {
    width: 100%;
    height: auto;
    display: block;
  }

  .body {
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .body {
      padding: 1.25rem;
    }
  }

  .head .pill-category {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.6rem;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.45rem;
    }
  }

  .desc {
    margin: 0 0 1rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .sep {
    opacity: 0.6;
  }

  /* 저자 이름이 이 줄에서 유일하게 색이 들어가는 자리입니다. */
  .who {
    font-weight: 600;
  }

  .who:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  hr {
    margin: 1.75rem 0;
  }

  .back {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .back:hover {
    color: var(--text);
  }
</style>
