---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../components/BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Icon from '../components/Icon.astro'
import { SITE_DESCRIPTION, getAuthor, getProject } from '../consts'

/**
 * `excerpt` 는 본문에서 뽑은 요약입니다. `<head>` 의 meta description 에만
 * 쓰고 화면에는 안 띄웁니다 — 소개문이 없는 글은 없는 채로 둡니다.
 */
type Props = CollectionEntry<'posts'>['data'] & { excerpt?: string }

const {
  title,
  description,
  excerpt,
  pubDate,
  updatedDate,
  heroImage,
  author,
  project,
} = Astro.props

const proj = project ? getProject(project) : undefined
const who = author ? getAuthor(author) : undefined
---

<BaseLayout
  title={title}
  description={description || excerpt || SITE_DESCRIPTION}
  image={heroImage}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  authorName={who?.name}
>
  <div class="shell">
    {/* ⚠ 시안에서 위로 올라왔습니다. 글을 다 읽고 나서보다, 잘못 들어왔을 때
        바로 나갈 수 있는 쪽이 쓸모가 큽니다. */}
    <a class="back" href="/">← 목록으로</a>

    <article>
      {
        /* public/ 의 원본이 그대로 나갑니다 — heroImage 는 Astro 자산이
           아니라 공개 경로라 <Image> 로 못 뽑습니다 (content.config.ts) */
        heroImage && <img class="hero" src={heroImage} alt="" />
      }

      <header class="head">
        {
          proj && (
            <a
              class="pill-category"
              style={`background-color:${proj.color}`}
              href={`/projects/${proj.id}`}
            >
              {proj.name}
            </a>
          )
        }
        <h1>{title}</h1>
        {description && <p class="desc">{description}</p>}
        <div class="meta">
          {
            who && (
              <>
                <a class="who" href={`/authors/${who.id}`} style={`color:${who.color}`}>
                  {who.name}
                </a>
                <span class="sep">·</span>
              </>
            )
          }
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <>
                <span class="sep">·</span>
                <span>
                  수정 <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }

          {/*
            조회수. 서버가 아는 값이 아니라 브라우저가 받아 옵니다 — 정적
            사이트라 빌드할 때는 셀 수가 없습니다. 못 받아오면 이 줄은
            **안 나온 채로 남습니다** (hidden 을 안 벗김). 로컬도 마찬가지.
          */}
          <span class="views" hidden>
            <span class="sep">·</span>
            <span class="v"><Icon name="eye" size={15} /><b data-views>0</b></span>
          </span>
        </div>
      </header>

      <hr />

      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /*
    ⚠ 본문은 **카드가 아니라 지면 위에 바로** 놓입니다 (2026-09-08 시안).
      예전에는 --card 판 위에 올려 뒀는데, 읽는 화면에서 글 폭만큼의 판이
      하나 더 있으면 그 안팎 경계가 계속 보입니다. 판을 걷어내면서 인용문
      쪽에 --card 를 옮겨 줬습니다 (global.css 의 .prose blockquote).
  */
  .shell {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  @media (max-width: 768px) {
    .shell {
      padding: 1rem 1rem 3rem;
    }
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 2rem;
    border-radius: var(--radius-card);
  }

  .head .pill-category {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.6rem;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }
  }

  .desc {
    margin: 0 0 1rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .sep {
    opacity: 0.6;
  }

  /* 저자 이름이 이 줄에서 유일하게 색이 들어가는 자리입니다. */
  .who {
    font-weight: 600;
  }

  .who:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
    조회수 — 눈 아이콘 + 숫자. 값이 오기 전에는 통째로 hidden 입니다.
    ⚠ display 를 주면 브라우저 기본 `[hidden]{display:none}` 을 이겨 버려서
      숨겨지지 않습니다. 그래서 [hidden] 을 한 줄 더 적어 둡니다.
  */
  .views {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .views[hidden] {
    display: none;
  }

  .v {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .v b {
    font-weight: 500;
  }

  hr {
    margin: 1.75rem 0 2rem;
  }
</style>

<script>
  /*
    코드 블록의 「복사」.

    ⚠ 단추 하나하나에 거는 게 아니라 **문서에 한 번** 겁니다. 비밀글은
      본문이 나중에 풀려서 그때 DOM 에 들어오는데(SecretGate), 그렇게 들어온
      코드 블록도 그대로 눌립니다.
    ⚠ `navigator.clipboard` 는 보안 컨텍스트(https·localhost)에만 있습니다.
      없으면 단추를 아예 안 보이게 둡니다 — 눌리지도 않는 단추가 코드마다
      붙어 있는 것보다 낫습니다 (`html.has-copy` 로 켭니다).
  */
  if (navigator.clipboard) {
    document.documentElement.classList.add('has-copy')

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null
      const btn = target && target.closest ? target.closest('.code-copy') : null
      if (!btn) return

      const fig = btn.closest('figure.code')
      const pre = fig ? fig.querySelector('pre') : null
      if (!pre) return

      try {
        await navigator.clipboard.writeText(pre.innerText)
        btn.textContent = '복사됨'
      } catch {
        btn.textContent = '실패'
      }
      setTimeout(() => {
        btn.textContent = '복사'
      }, 1200)
    })
  }
</script>

<script>
  /*
    조회수 — 세고, 화면에 띄웁니다.

    ⚠ **2026-09-08 시안부터 숫자가 읽는 사람한테도 보입니다.** 그전에는
      §6-6 대로 순서만 공개하고 숫자는 `/admin` 에서 열쇠를 넣어야 볼 수
      있었습니다. 그래서 api/views.js 도 같이 고쳤습니다 — POST 가 올린 뒤의
      값을 돌려주고, `?slug=` 로 한 편만 물어볼 수 있습니다.

    ⚠ **주소에서 slug 를 뽑습니다.** 글 주소가 `/posts/<slug>/` 라 그대로
      쓰면 되고, 그래야 이 파일을 쓰는 쪽에 prop 을 하나 더 안 붙입니다.

    ⚠ **같은 기기는 하루에 한 번만 셉니다.** 오탈자를 고치느라 같은 글을
      열 번 열어도 열 번 세면 제 손이 순위를 만듭니다. 오늘 이미 센
      기기는 올리지 않고 `?slug=` 로 숫자만 물어봅니다.

    ⚠ **정확한 숫자가 아닙니다.** 광고 차단기와 봇은 못 거릅니다. 화면
      어디에도 정확한 것처럼 적지 마세요.

    ⚠ **로컬에서는 세지도 않고 띄우지도 않습니다.** 개발하면서 새로고침한
      것이 순위에 섞이고, `/api` 가 아예 없어서 Vite 가 **함수 소스를 그대로**
      내줍니다 (404 가 아닙니다 — §6-6).
  */
  const ONE_DAY = 24 * 60 * 60 * 1000

  const local = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
  const slug = location.pathname.replace(/^\/posts\//, '').replace(/\/+$/, '')

  const box = document.querySelector<HTMLElement>('.views')
  const out = document.querySelector<HTMLElement>('[data-views]')

  function show(n: unknown) {
    if (!box || !out || typeof n !== 'number' || !Number.isFinite(n)) return
    out.textContent = n.toLocaleString('ko-KR')
    box.hidden = false
  }

  async function views() {
    if (local || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return

    const key = 'lim.view.' + slug
    let fresh = true
    try {
      const last = Number(localStorage.getItem(key) || 0)
      fresh = !last || Date.now() - last > ONE_DAY
    } catch {
      /* 사생활 보호 창에서는 localStorage 가 던집니다 — 그냥 셉니다 */
    }

    if (!fresh) {
      const r = await fetch(`/api/views?slug=${encodeURIComponent(slug)}`)
      if (r.ok) show((await r.json()).views)
      return
    }

    try {
      localStorage.setItem(key, String(Date.now()))
    } catch {}

    const r = await fetch('/api/views', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug }),
      keepalive: true,
    })
    if (r.ok) show((await r.json()).views)
  }

  /* 실패하면 그 줄이 안 나온 채로 남습니다 — 0 이라고 적지 않습니다. */
  views().catch(() => {})
</script>
